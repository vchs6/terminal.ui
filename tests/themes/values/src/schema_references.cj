package theme_values_contract
import cjtui.style.*
import cjtui.theme.*

func schemaReferences(): Unit {
    check(parseBody("[text]\nforeground={ref=\"v\"}\n[variables.v]\ntype=\"color\"\nvalue=\"red\"\n").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Red)), "forward reference color")
    check(parseBody("[text]\nbold={ref=\"v\"}\n[variables.v]\ntype=\"bool\"\nvalue=false\n").textDefaults() == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(false)), "forward reference bool")
    check(parseBody("[decoration]\nborder={ref=\"v\"}\n[variables.v]\ntype=\"border\"\nvalue=\"rounded\"\n").decorationDefaults() == StyleRule().withValue(StyleKeys.border, StyleValue<BorderStyle>.Value(BorderStyle.Rounded)), "forward reference border")
    check(parseBody("[spacing]\ngap={ref=\"v\"}\n[variables.v]\ntype=\"cells\"\nvalue=0\n").spacingDefaults() == StyleRule().withValue(StyleKeys.gap, StyleValue<Int64>.Value(0)), "forward reference cells")
    check(parseBody("[decoration]\nshadow_offset_x={ref=\"v\"}\n[variables.v]\ntype=\"offset\"\nvalue=-1\n").decorationDefaults() == StyleRule().withValue(StyleKeys.shadowOffsetX, StyleValue<Int64>.Value(-1)), "forward reference offset")
    check(parseBody("[spacing]\nwidth={ref=\"v\"}\n[variables.v]\ntype=\"dimension\"\nvalue=\"auto\"\n").spacingDefaults() == StyleRule().withValue(StyleKeys.width, StyleValue<Dimension>.Value(Dimension.Auto)), "forward reference dimension")
    check(parseBody("[spacing]\nalign_items={ref=\"v\"}\n[variables.v]\ntype=\"alignment\"\nvalue=\"stretch\"\n").spacingDefaults() == StyleRule().withValue(StyleKeys.alignItems, StyleValue<Alignment>.Value(Alignment.Stretch)), "forward reference alignment")
    check(parseBody("[text]\nalign={ref=\"v\"}\n[variables.v]\ntype=\"text_alignment\"\nvalue=\"center\"\n").textDefaults() == StyleRule().withValue(StyleKeys.textAlign, StyleValue<Alignment>.Value(Alignment.Center)), "forward reference text_alignment")
    check(parseBody("[text]\nwrap={ref=\"v\"}\n[variables.v]\ntype=\"wrap\"\nvalue=\"none\"\n").textDefaults() == StyleRule().withValue(StyleKeys.textWrap, StyleValue<TextWrap>.Value(TextWrap.None)), "forward reference wrap")
    check(parseBody("[text]\noverflow={ref=\"v\"}\n[variables.v]\ntype=\"overflow\"\nvalue=\"clip\"\n").textDefaults() == StyleRule().withValue(StyleKeys.textOverflow, StyleValue<TextOverflow>.Value(TextOverflow.Clip)), "forward reference overflow")
    check(parseBody("[text]\nforeground=\"default\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Default)), "color default")
    check(parseBody("[text]\nforeground=\"black\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Black)), "color black")
    check(parseBody("[text]\nforeground=\"red\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Red)), "color red")
    check(parseBody("[text]\nforeground=\"green\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Green)), "color green")
    check(parseBody("[text]\nforeground=\"yellow\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Yellow)), "color yellow")
    check(parseBody("[text]\nforeground=\"blue\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Blue)), "color blue")
    check(parseBody("[text]\nforeground=\"magenta\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Magenta)), "color magenta")
    check(parseBody("[text]\nforeground=\"cyan\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.Cyan)), "color cyan")
    check(parseBody("[text]\nforeground=\"white\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.White)), "color white")
    check(parseBody("[text]\nforeground=\"bright-black\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightBlack)), "color bright-black")
    check(parseBody("[text]\nforeground=\"bright-red\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightRed)), "color bright-red")
    check(parseBody("[text]\nforeground=\"bright-green\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightGreen)), "color bright-green")
    check(parseBody("[text]\nforeground=\"bright-yellow\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightYellow)), "color bright-yellow")
    check(parseBody("[text]\nforeground=\"bright-blue\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightBlue)), "color bright-blue")
    check(parseBody("[text]\nforeground=\"bright-magenta\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightMagenta)), "color bright-magenta")
    check(parseBody("[text]\nforeground=\"bright-cyan\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightCyan)), "color bright-cyan")
    check(parseBody("[text]\nforeground=\"bright-white\"").textDefaults() == StyleRule().withValue(StyleKeys.foreground, StyleValue<Color>.Value(Color.BrightWhite)), "color bright-white")
    check(parseBody("[components.generic.text]\nbold=true").componentRule(ThemeRole.Generic) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role generic")
    check(parseBody("[components.text.text]\nbold=true").componentRule(ThemeRole.Text) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role text")
    check(parseBody("[components.row.text]\nbold=true").componentRule(ThemeRole.Row) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role row")
    check(parseBody("[components.column.text]\nbold=true").componentRule(ThemeRole.Column) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role column")
    check(parseBody("[components.label.text]\nbold=true").componentRule(ThemeRole.Label) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role label")
    check(parseBody("[components.button.text]\nbold=true").componentRule(ThemeRole.Button) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role button")
    check(parseBody("[components.radio.text]\nbold=true").componentRule(ThemeRole.Radio) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role radio")
    check(parseBody("[components.checkbox.text]\nbold=true").componentRule(ThemeRole.Checkbox) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role checkbox")
    check(parseBody("[components.progress.text]\nbold=true").componentRule(ThemeRole.Progress) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role progress")
    check(parseBody("[components.text_input.text]\nbold=true").componentRule(ThemeRole.TextInput) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role text_input")
    check(parseBody("[components.text_area.text]\nbold=true").componentRule(ThemeRole.TextArea) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role text_area")
    check(parseBody("[components.horizontal_menu.text]\nbold=true").componentRule(ThemeRole.HorizontalMenu) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role horizontal_menu")
    check(parseBody("[components.popup_menu.text]\nbold=true").componentRule(ThemeRole.PopupMenu) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role popup_menu")
    check(parseBody("[components.menu_item.text]\nbold=true").componentRule(ThemeRole.MenuItem) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role menu_item")
    check(parseBody("[components.status_bar.text]\nbold=true").componentRule(ThemeRole.StatusBar) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role status_bar")
    check(parseBody("[components.modal.text]\nbold=true").componentRule(ThemeRole.Modal) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role modal")
    check(parseBody("[components.split_pane.text]\nbold=true").componentRule(ThemeRole.SplitPane) == StyleRule().withValue(StyleKeys.bold, StyleValue<Bool>.Value(true)), "role split_pane")
}
