package theme_values_contract
import cjtui.style.*
import cjtui.theme.*

func schemaFailures(): Unit {
    failure("", "MissingRequired", "schema_version")
    failure("schema_version=1", "MissingRequired", "name")
    failure("schema_version=2\nname=\"x\"", "UnsupportedVersion", "schema_version")
    failure("schema_version=\"1\"\nname=\"x\"", "InvalidType", "schema_version")
    failure("schema_version=1\nname=\" \"", "InvalidValue", "name")
    invalid("include=\"other.toml\"", "UnknownKey", "include")
    invalid("text.colour=\"red\"", "UnknownKey", "text.colour")
    invalid("text.bold=1", "InvalidType", "text.bold")
    invalid("text.bold=\"true\"", "InvalidType", "text.bold")
    invalid("text.bold={reset=false}", "InvalidValue", "text.bold")
    invalid("text.bold={}", "InvalidValue", "text.bold")
    invalid("text.foreground=\"RED\"", "InvalidValue", "text.foreground")
    invalid("text.foreground=\"#fff\"", "InvalidValue", "text.foreground")
    invalid("text.foreground=\"#01020304\"", "InvalidValue", "text.foreground")
    invalid("text.foreground=\"transparent\"", "InvalidValue", "text.foreground")
    invalid("text.foreground={indexed=-1}", "OutOfRange", "text.foreground")
    invalid("text.foreground={indexed=256}", "OutOfRange", "text.foreground")
    invalid("text.foreground={indexed=1.0}", "InvalidType", "text.foreground")
    invalid("text.align=\"stretch\"", "InvalidValue", "text.align")
    invalid("text.wrap=\"word\"", "InvalidValue", "text.wrap")
    invalid("text.overflow=\"dots\"", "InvalidValue", "text.overflow")
    invalid("spacing.width=-1", "OutOfRange", "spacing.width")
    invalid("spacing.height=1.0", "InvalidType", "spacing.height")
    invalid("spacing.gap=true", "InvalidType", "spacing.gap")
    invalid("spacing.min_width=\"1\"", "InvalidType", "spacing.min_width")
    invalid("spacing.justify_content=\"stretch\"", "InvalidValue", "spacing.justify_content")
    invalid("decoration.border=\"solid\"", "InvalidValue", "decoration.border")
    invalid("decoration.shadow_offset_x=\"-1\"", "InvalidType", "decoration.shadow_offset_x")
    invalid("[components.unknown.text]\nbold=true", "UnknownRole", "components.unknown")
    invalid("[components.text.spacing]\ngap=1", "UnsupportedProperty", "components.text.spacing.gap")
    invalid("[components.row.text]\nwrap=\"grapheme\"", "UnsupportedProperty", "components.row.text.wrap")
    invalid("[components.progress.text]\nalign=\"center\"", "UnsupportedProperty", "components.progress.text.align")
    invalid("[styles.x.states.hover.text]\nbold=true", "UnknownState", "styles.x.states.hover")
    invalid("[styles.x]\nstates=\"focused\"", "InvalidType", "styles.x.states")
    invalid("[styles.x.text]\nbold=true\n[styles.x.states.normal.text]\nbold=true", "DuplicateProperty", "styles.x.states.normal.text.bold")
    invalid("[variables.bad]\ntype=\"bool\"\nvalue=1", "InvalidType", "variables.bad.value")
    invalid("[variables.bad]\ntype=\"color\"\nvalue=\"unknown\"", "InvalidValue", "variables.bad.value")
    invalid("[variables.bad]\ntype=\"cells\"\nvalue={ref=\"x\"}", "InvalidType", "variables.bad.value")
    invalid("[variables.bad]\ntype=\"float\"\nvalue=1", "InvalidValue", "variables.bad.type")
    invalid("[styles.\"bad.name\".text]\nbold=true", "InvalidName", "styles.bad.name")
    invalid("text.foreground={ref=\"missing\"}", "UnknownReference", "text.foreground")
    invalid("text.bold={ref=\"c\"}\n[variables.c]\ntype=\"color\"\nvalue=\"red\"", "ReferenceTypeMismatch", "text.bold")
    invalid("text.bold=true\ntext.bold=false", "SyntaxError", "text.bold")
    invalid("text.bold=null", "SyntaxError", "text.bold")
    invalid("text.bold=1\ntext.unknown=true", "InvalidType", "text.bold")
    invalid("text.unknown=true\ntext.bold=1", "UnknownKey", "text.unknown")
    invalid("[styles.unused.text]\nwrap=\"word\"", "InvalidValue", "styles.unused.text.wrap")
    malformedRecord("text.bold={ref=\"x\",reset=true}","text.bold")
    malformedRecord("text.bold={reset=true,value=false}","text.bold")
    malformedRecord("text.bold={ref=\"\"}","text.bold")
    malformedRecord("text.bold={unknown=true}","text.bold")
    invalid("decoration.roundness=1","UnknownKey","decoration.roundness")
    invalid("spacing.margin=1","UnknownKey","spacing.margin")
    invalid("text=1","InvalidType","text")
    invalid("decoration=[]","InvalidType","decoration")
    invalid("spacing=true","InvalidType","spacing")
    invalid("[styles.x]\nunknown=true","UnknownKey","styles.x.unknown")
    invalid("[components.text]\nunknown=true","UnknownKey","components.text.unknown")
    invalid("[variables.x]\ntype=\"bool\"\nvalue=false\nextra=1","UnknownKey","variables.x.extra")
    invalid("[variables.x]\ntype=\"bool\"","MissingRequired","variables.x.value")
    let disjoint = parseBody("[styles.x.text]\nbold=true\n[styles.x.states.normal.text]\ndim=true")
    check(named(disjoint,"x") == StyleRule().withValue(StyleKeys.bold,StyleValue<Bool>.Value(true)).withValue(StyleKeys.dim,StyleValue<Bool>.Value(true)), "disjoint normal shorthand and states.normal are legal")
    let maxCells = parseBody("spacing.min_width=9223372036854775807")
    check(maxCells.spacingDefaults() == StyleRule().withValue(StyleKeys.minWidth, StyleValue<Int64>.Value(Int64.Max)), "Int64 maximum cells is exact")
    let minOffset = parseBody("decoration.shadow_offset_x=-9223372036854775808")
    check(minOffset.decorationDefaults() == StyleRule().withValue(StyleKeys.shadowOffsetX, StyleValue<Int64>.Value(Int64.Min)), "Int64 minimum offset is exact")
    capacityFile("integer-too-high.toml", "OutOfRange")
    capacityFile("integer-too-low.toml", "OutOfRange")
    check(parseBody("spacing.width=0x7f").spacingDefaults() == StyleRule().withValue(StyleKeys.width, StyleValue<Dimension>.Value(Dimension.Cells(127))), "legal TOML radix integer")
    check(parseBody("spacing.min_width=+1_000").spacingDefaults() == StyleRule().withValue(StyleKeys.minWidth, StyleValue<Int64>.Value(1000)), "legal TOML signed underscore integer")
}
