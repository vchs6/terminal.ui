package cjtui

import std.unittest.*
import std.unittest.testmacro.*

func glyphCheck(value: Bool, name: String): Unit {
    if (!value) { throw Exception("FAIL ${name}") }
}

func glyphBitmap(): Array<UInt8> {
    let bitmap = Array<UInt8>(8192, repeat: 0u8)
    // Independent little-bit BMP coverage: ASCII space..tilde, é, 中, 文, …,
    // combining acute, VS16, ZWJ. The members do not establish cluster support.
    for (index in 4..16) { bitmap[index] = 255u8 }
    bitmap[15] = 127u8
    bitmap[29] = 2u8       // U+00E9 = 29*8 + 1
    bitmap[96] = 2u8       // U+0301 = 96*8 + 1
    bitmap[1025] = 32u8    // U+200D = 1025*8 + 5
    bitmap[1028] = 64u8    // U+2026 = 1028*8 + 6
    bitmap[1249] = 1u8     // U+2708 = 1249*8 + 0
    bitmap[2501] = 32u8    // U+4E2D = 2501*8 + 5
    bitmap[3248] = 128u8   // U+6587 = 3248*8 + 7
    bitmap[8129] = 128u8
    bitmap[8191] = 32u8    // U+FFFD = 8191*8 + 5, highest bitmap byte
    return bitmap
}

@Test
func glyph_projection_modes(): Unit {
    let unicode = GlyphRenderPolicy.unicode()
    let ascii = GlyphRenderPolicy.ascii()
    let mapped = GlyphRenderPolicy.mapped(glyphBitmap())
    // Every expected string below is literal, never generated by the product.
    for ((text, width, expectedAscii, expectedMapped) in [
        ("A", 1, "A", "A"), (" ", 1, " ", " "), ("~", 1, "~", "~"),
        ("é", 1, "?", "é"), ("ö", 1, "?", "?"), ("e\u{301}", 1, "?", "?"),
        ("中文", 4, "????", "????"), ("中", 2, "??", "??"), ("文", 2, "??", "??"),
        ("😀", 2, "??", "??"), ("✈", 1, "?", "✈"), ("✈\u{fe0f}", 2, "??", "??"), ("👩‍💻", 2, "??", "??"),
        ("\u{fffd}", 1, "?", "\u{fffd}"),
        ("…", 1, "?", "…"), ("░", 1, "?", "?"), ("A", 2, "??", "??"),
        ("\u{301}", 0, "", "")
    ]) {
        glyphCheck(projectTerminalGlyph(text, width, ascii) == expectedAscii, "Ascii literal projection ${text}")
        glyphCheck(projectTerminalGlyph(text, width, mapped) == expectedMapped, "mapped literal projection ${text}")
        glyphCheck(projectTerminalGlyph(text, width, unicode) == if (width == 0) { "" } else { text },
            "Unicode exact cluster and width0 ${text}")
    }
    var rejected = false
    try { projectTerminalGlyph("A", -1, ascii) } catch (_: IllegalArgumentException) { rejected = true }
    glyphCheck(rejected, "negative width rejected")
}

@Test
func glyph_bitmap_bounds_and_ownership(): Unit {
    for (size in [0, 8191, 8193]) {
        var rejected = false
        try { GlyphRenderPolicy.mapped(Array<UInt8>(size, repeat: 0u8)) }
        catch (_: IllegalArgumentException) { rejected = true }
        glyphCheck(rejected, "bitmap exact8192 ${size}")
    }
    let bitmap = glyphBitmap()
    let policy = GlyphRenderPolicy.mapped(bitmap)
    bitmap[29] = 0u8
    glyphCheck(projectTerminalGlyph("é", 1, policy) == "é", "bitmap is frozen defensive copy")
    let empty = GlyphRenderPolicy.mapped(Array<UInt8>(8192, repeat: 0u8))
    glyphCheck(projectTerminalGlyph("é", 1, empty) == " ", "known empty map uses invisible column placeholder")
    glyphCheck(projectTerminalGlyph("中", 2, empty) == "  ", "known empty map preserves wide columns")
    let onlyQuestion = Array<UInt8>(8192, repeat: 0u8)
    onlyQuestion[7] = 128u8
    let questions = GlyphRenderPolicy.mapped(onlyQuestion)
    glyphCheck(projectTerminalGlyph("A", 1, questions) == "?", "ASCII is checked when map known")
    glyphCheck(projectTerminalGlyph("…", 1, questions) == "?", "literal missing ellipsis is one column")
    glyphCheck(projectTerminalGlyph("┌", 1, questions) == "?", "border fallback then generic placeholder")
}

@Test
func glyph_border_group_reuse(): Unit {
    let ascii = GlyphRenderPolicy.ascii()
    for (corner in ["┌", "┐", "└", "┘", "╭", "╮", "╰", "╯", "╔", "╗", "╚", "╝"]) {
        glyphCheck(projectTerminalGlyph(corner, 1, ascii) == "+", "border corner ${corner}")
    }
    for (horizontal in ["─", "═"]) {
        glyphCheck(projectTerminalGlyph(horizontal, 1, ascii) == "-", "border horizontal ${horizontal}")
    }
    for (vertical in ["│", "║"]) {
        glyphCheck(projectTerminalGlyph(vertical, 1, ascii) == "|", "border vertical ${vertical}")
    }
    let bitmap = glyphBitmap()
    bitmap[5] = bitmap[5] & 247u8 // remove '+' while '?' remains mapped
    glyphCheck(projectTerminalGlyph("╭", 1, GlyphRenderPolicy.mapped(bitmap)) == "?",
        "missing specialized fallback uses question")
}

@Test
func glyph_generated_marker_function_only(): Unit {
    glyphCheck(displayWidth("…", ambiguousWide: false) == 1, "actual shared ambiguous narrow width")
    glyphCheck(displayWidth("…", ambiguousWide: true) == 2, "actual shared ambiguous wide width")
    let unicode = GlyphRenderPolicy.unicode()
    let ascii = GlyphRenderPolicy.ascii()
    let mapped = GlyphRenderPolicy.mapped(glyphBitmap())
    let missingMap = glyphBitmap()
    missingMap[1028] = 0u8
    let missing = GlyphRenderPolicy.mapped(missingMap)
    for ((columns, dots, unicodeMarker) in [(-1, "", ""), (0, "", ""), (1, ".", "…"),
        (2, "..", "…"), (3, "...", "…"), (5, "...", "…")]) {
        glyphCheck(generatedEllipsis(unicode, columns, ambiguousWide: false) == unicodeMarker, "Unicode marker ${columns}")
        glyphCheck(generatedEllipsis(mapped, columns, ambiguousWide: false) == unicodeMarker, "mapped marker ${columns}")
        glyphCheck(generatedEllipsis(ascii, columns, ambiguousWide: false) == dots, "Ascii marker ${columns}")
        glyphCheck(generatedEllipsis(missing, columns, ambiguousWide: false) == dots, "missing marker ${columns}")
        for (policy in [unicode, ascii, mapped, missing]) {
            glyphCheck(generatedEllipsis(policy, columns, ambiguousWide: true) == dots,
                "ambiguousWide true must choose dots ${columns}")
        }
    }
    glyphCheck(projectTerminalGlyph("…", 1, ascii) == "?", "literal ellipsis remains one question, never three dots")
}
