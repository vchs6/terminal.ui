diff --git a/src/terminal_glyph_projection.cj b/src/terminal_glyph_projection.cj
new file mode 100644
index 0000000..781331d
--- /dev/null
+++ b/src/terminal_glyph_projection.cj
@@ -0,0 +1,29 @@
+package cjtui
+
+func projectTerminalGlyph(grapheme: String, width: Int64, policy: GlyphRenderPolicy): String {
+    if (width < 0) {
+        throw IllegalArgumentException("negative terminal glyph width")
+    }
+    if (width == 0) {
+        return ""
+    }
+    if (!policy.conservative) {
+        return grapheme
+    }
+    var remaining = width
+    var matches = true
+    for (scalar in grapheme.runes()) {
+        let scalarWidth = displayWidth(scalar.toString())
+        // Subtract from the stored column budget, so the sum cannot overflow.
+        if (scalarWidth < 0 || scalarWidth > remaining) {
+            matches = false
+            break
+        }
+        remaining -= scalarWidth
+    }
+    if (matches && remaining == 0) {
+        return grapheme
+    }
+    // Positive widths come from validated Frame heads and their allocation budget.
+    String.fromUtf8(Array<UInt8>(width, repeat: 63))
+}
diff --git a/src/terminal_projected_row.cj b/src/terminal_projected_row.cj
new file mode 100644
index 0000000..fada7ce
--- /dev/null
+++ b/src/terminal_projected_row.cj
@@ -0,0 +1,58 @@
+package cjtui
+
+func projectTerminalRow(frame: Frame, y: Int64, profile: TerminalRenderProfile): Array<Cell> {
+    let row = Array<Cell>(frame.width, {_ => blankCell(false)})
+    var raw = Style()
+    var style = projectTerminalStyle(raw, profile)
+    var x = 0
+    while (x < frame.width) {
+        let cell = frame.cellAt(x, y)
+        if (cell.style != raw) {
+            raw = cell.style
+            style = projectTerminalStyle(raw, profile)
+        }
+        let glyph = projectTerminalGlyph(cell.grapheme, cell.width, profile.glyphPolicy)
+        if (glyph == cell.grapheme) {
+            row[x] = Cell(glyph, cell.width, false, style)
+            for (i in 1..cell.width) {
+                row[x + i] = Cell("", 0, true, style)
+            }
+        } else {
+            // A fallback occupies independent printable columns, just like literal '?'.
+            for (i in 0..cell.width) {
+                row[x + i] = Cell("?", 1, false, style)
+            }
+        }
+        x += cell.width
+    }
+    row
+}
+
+func terminalRowsEqual(a: Array<Cell>, b: Array<Cell>): Bool {
+    for (x in 0..a.size) {
+        if (a[x].grapheme != b[x].grapheme || a[x].width != b[x].width || a[x].continuation != b[x].continuation ||
+            a[x].style != b[x].style) {
+            return false
+        }
+    }
+    true
+}
+
+func encodeTerminalRow(row: Array<Cell>, resetAtEnd: Bool): String {
+    var out = ""
+    let defaultStyle = Style()
+    var previous = defaultStyle
+    for (cell in row) {
+        if (!cell.continuation) {
+            if (cell.style != previous) {
+                out += encodeStyle(cell.style)
+                previous = cell.style
+            }
+            out += cell.grapheme
+        }
+    }
+    if (resetAtEnd && previous != defaultStyle) {
+        out += resetStyle()
+    }
+    out
+}
