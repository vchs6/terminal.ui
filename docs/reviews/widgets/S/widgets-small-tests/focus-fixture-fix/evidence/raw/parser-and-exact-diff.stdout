diff --git a/tests/widgets_small/src/event_boundaries.cj b/tests/widgets_small/src/event_boundaries.cj
index d8c0b31e..02cf5dd6 100644
--- a/tests/widgets_small/src/event_boundaries.cj
+++ b/tests/widgets_small/src/event_boundaries.cj
@@ -87,7 +87,8 @@ func duplicateRadioLabels(): Unit {
     // Selection writes schedule visual evaluation at the boundary, so exact default
     // getter-read count is measured with a separate non-writing callback below.
     assertEvent(requests[0] == 1 && requests[1] == 0 && selected.get() == "a", "same captions preserve application IDs")
-    children[1].requestFocus()
+    app.batch({ => children[1].requestFocus() })
+    assertEvent(children[1].isFocused(), "second Radio focused before positive activation")
     app.dispatch(children[1], KeyEvent("text", text: " "))
     assertEvent(requests[0] == 1 && requests[1] == 1 && selected.get() == "b", "application alone groups radios")
     equal(app.snapshot(8, 2).toPlainText(), "( ) same\n(*) same", "duplicate label exact controlled frames")
diff --git a/tests/widgets_small/src/remount_cases.cj b/tests/widgets_small/src/remount_cases.cj
index 171f775e..fff1cf17 100644
--- a/tests/widgets_small/src/remount_cases.cj
+++ b/tests/widgets_small/src/remount_cases.cj
@@ -39,7 +39,8 @@ func remountAndWorkerPosts(): Unit {
     assertLifetime(posted.get(), "live owner worker post accepted")
     equal(app.snapshot(2, 1).toPlainText(), "9 ", "worker post updates public model on UI turn")
     assertLifetime(!app.post(old, { => staleRan[0] = true }), "stale owner post rejected")
-    current.requestFocus()
+    app.batch({ => current.requestFocus() })
+    assertLifetime(current.isFocused(), "remounted control focused before positive activation")
     app.dispatch(current, KeyEvent("enter"))
     assertLifetime(model.get() == 10, "remounted callback updates model once")
     app.dispose(); app.dispose()
