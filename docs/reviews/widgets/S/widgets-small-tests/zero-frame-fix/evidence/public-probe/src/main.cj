package zero_frame_public_probe

import cjtui.Frame

func equal(actual: String, expected: String, name: String): Unit {
    if (actual != expected) { throw Exception(name) }
}

main(): Int64 {
    // Manual goldens from accepted Frame design section2, not generated by Frame.
    equal(Frame(0, 0).toPlainText(), "", "zero width and height")
    equal(Frame(0, 1).toPlainText(), "", "one empty row")
    equal(Frame(0, 2).toPlainText(), "\n", "two empty rows have one separator LF")
    equal(Frame(1, 0).toPlainText(), "", "zero height")
    println("PUBLIC_FRAME_MANUAL_ZERO_GOLDENS_PASS")
    0
}
