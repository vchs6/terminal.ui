package theme_integration_contract
import cjtui.*
func sourceAndStateCascade(): Unit {
    let value = theme("[text]\nforeground=\"white\"\nbackground=\"black\"\n[components.text.text]\nforeground=\"green\"\nbackground=\"white\"\nbold=true\ndim=true\nitalic=true\nunderline=true\ninverse=true\nstrikethrough=true\n[styles.early.text]\nbackground=\"blue\"\nbold=true\n[styles.early.states.disabled.text]\nbold=true\nforeground=\"yellow\"\n[styles.late.text]\nbold=false\n")
    let c = Text("x").styles([StyleUse.Named("early"), StyleUse.Named("late")]).foreground(Color.Red)
        .setStyle(StyleKeys.dim, StyleValue<Bool>.Value(false))
        .setStyle(StyleKeys.italic, StyleValue<Bool>.Reset)
        .setStyle(StyleKeys.underline, StyleValue<Bool>.Value(false))
        .setStyle(StyleKeys.inverse, StyleValue<Bool>.Value(false))
        .setStyle(StyleKeys.strikethrough, StyleValue<Bool>.Value(false))
        .visualStates(VisualStates(focused: true, selected: true, disabled: true))
    styleAt(picture(c, value, 1, 1), 0, 0, Style(foreground: Color.Red, background: Color.Blue), "four sources resolve every text field separately; later normal beats early disabled")
    let states = Text("x").visualStates(VisualStates(focused: true, selected: true, disabled: true))
        .setStyle(StyleKeys.foreground, StyleValue<Color>.Value(Color.Red), state: VisualState.Selected)
        .setStyle(StyleKeys.background, StyleValue<Color>.Value(Color.Blue), state: VisualState.Focused)
        .setStyle(StyleKeys.foreground, StyleValue<Color>.Reset, state: VisualState.Disabled)
        .setStyle(StyleKeys.bold, StyleValue<Bool>.Value(false), state: VisualState.Disabled)
    let expected = Style(background: Color.Blue, dim: true, italic: true, underline: true, inverse: true, strikethrough: true)
    styleAt(picture(states, value, 1, 1),0,0,expected,"disabled Reset stops selected/normal/theme, while focused background is independently used")
    let unset = Text("x").foreground(Color.Red)
        .setStyle(StyleKeys.foreground, StyleValue<Color>.Reset, state: VisualState.Disabled)
        .setStyle(StyleKeys.foreground, StyleValue<Color>.Unset, state: VisualState.Disabled)
        .visualStates(VisualStates(disabled: true))
    check(picture(unset, value,1,1).cellAt(0,0).style.foreground == Color.Red,"Unset removes Reset and reveals same-source normal")
    let reordered = Text("x").styles([StyleUse.Named("late"),StyleUse.Named("early")]).visualStates(VisualStates(disabled:true))
    check(picture(reordered,value,1,1).cellAt(0,0).style.bold,"named list order dominates state specificity between rules")
    let fallback = theme("[components.text.states.disabled.text]\nforeground=\"green\"\n")
    styleAt(picture(Text("x").foreground(Color.Red).visualStates(VisualStates(disabled:true)),fallback,1,1),0,0,Style(foreground:Color.Red),"explicit normal beats role disabled")
    let rule = StyleRule().withValue(StyleKeys.background,StyleValue<Color>.Value(Color.Cyan))
    styleAt(picture(Text("x").styles([StyleUse.Inline(rule)]),theme(""),1,1),0,0,Style(background:Color.Cyan),"inline reusable source participates in same resolver")
    // Non-text fields: spacing and border also obey source and state precedence.
    let boxTheme = theme("[spacing]\npadding_left=2\n[decoration]\nborder=\"double\"\n[components.text.spacing]\npadding_left=1\n[styles.box.spacing]\npadding_left=0\n[styles.box.decoration]\nborder=\"ascii\"\n")
    let box = Text("x").styles([StyleUse.Named("box")]).setStyle(StyleKeys.border,StyleValue<BorderStyle>.Reset)
    check(picture(box,boxTheme,3,1).toPlainText()=="x  ","explicit border Reset and reusable padding Value(0) terminate lower sources")
}
