package cjtui.style
public class StyleKeys {
    public static let foreground: StyleKey<Color> = StyleKey<Color>("foreground", {d, s => d.colorValues[0 * 4 + s]}, {d, s, v => d.colorValues[0 * 4 + s] = v}, {_ => ()})
    public static let background: StyleKey<Color> = StyleKey<Color>("background", {d, s => d.colorValues[1 * 4 + s]}, {d, s, v => d.colorValues[1 * 4 + s] = v}, {_ => ()})
    public static let borderForeground: StyleKey<Color> = StyleKey<Color>("borderForeground", {d, s => d.colorValues[2 * 4 + s]}, {d, s, v => d.colorValues[2 * 4 + s] = v}, {_ => ()})
    public static let shadowForeground: StyleKey<Color> = StyleKey<Color>("shadowForeground", {d, s => d.colorValues[3 * 4 + s]}, {d, s, v => d.colorValues[3 * 4 + s] = v}, {_ => ()})
    public static let shadowBackground: StyleKey<Color> = StyleKey<Color>("shadowBackground", {d, s => d.colorValues[4 * 4 + s]}, {d, s, v => d.colorValues[4 * 4 + s] = v}, {_ => ()})
    public static let bold: StyleKey<Bool> = StyleKey<Bool>("bold", {d, s => d.boolValues[0 * 4 + s]}, {d, s, v => d.boolValues[0 * 4 + s] = v}, {_ => ()})
    public static let dim: StyleKey<Bool> = StyleKey<Bool>("dim", {d, s => d.boolValues[1 * 4 + s]}, {d, s, v => d.boolValues[1 * 4 + s] = v}, {_ => ()})
    public static let italic: StyleKey<Bool> = StyleKey<Bool>("italic", {d, s => d.boolValues[2 * 4 + s]}, {d, s, v => d.boolValues[2 * 4 + s] = v}, {_ => ()})
    public static let underline: StyleKey<Bool> = StyleKey<Bool>("underline", {d, s => d.boolValues[3 * 4 + s]}, {d, s, v => d.boolValues[3 * 4 + s] = v}, {_ => ()})
    public static let inverse: StyleKey<Bool> = StyleKey<Bool>("inverse", {d, s => d.boolValues[4 * 4 + s]}, {d, s, v => d.boolValues[4 * 4 + s] = v}, {_ => ()})
    public static let strikethrough: StyleKey<Bool> = StyleKey<Bool>("strikethrough", {d, s => d.boolValues[5 * 4 + s]}, {d, s, v => d.boolValues[5 * 4 + s] = v}, {_ => ()})
    public static let shadowEnabled: StyleKey<Bool> = StyleKey<Bool>("shadowEnabled", {d, s => d.boolValues[6 * 4 + s]}, {d, s, v => d.boolValues[6 * 4 + s] = v}, {_ => ()})
    public static let shadowBold: StyleKey<Bool> = StyleKey<Bool>("shadowBold", {d, s => d.boolValues[7 * 4 + s]}, {d, s, v => d.boolValues[7 * 4 + s] = v}, {_ => ()})
    public static let shadowDim: StyleKey<Bool> = StyleKey<Bool>("shadowDim", {d, s => d.boolValues[8 * 4 + s]}, {d, s, v => d.boolValues[8 * 4 + s] = v}, {_ => ()})
    public static let shadowItalic: StyleKey<Bool> = StyleKey<Bool>("shadowItalic", {d, s => d.boolValues[9 * 4 + s]}, {d, s, v => d.boolValues[9 * 4 + s] = v}, {_ => ()})
    public static let shadowUnderline: StyleKey<Bool> = StyleKey<Bool>("shadowUnderline", {d, s => d.boolValues[10 * 4 + s]}, {d, s, v => d.boolValues[10 * 4 + s] = v}, {_ => ()})
    public static let shadowInverse: StyleKey<Bool> = StyleKey<Bool>("shadowInverse", {d, s => d.boolValues[11 * 4 + s]}, {d, s, v => d.boolValues[11 * 4 + s] = v}, {_ => ()})
    public static let shadowStrikethrough: StyleKey<Bool> = StyleKey<Bool>("shadowStrikethrough", {d, s => d.boolValues[12 * 4 + s]}, {d, s, v => d.boolValues[12 * 4 + s] = v}, {_ => ()})
    public static let shadowOffsetX: StyleKey<Int64> = StyleKey<Int64>("shadowOffsetX", {d, s => d.int64Values[0 * 4 + s]}, {d, s, v => d.int64Values[0 * 4 + s] = v}, {_ => ()})
    public static let shadowOffsetY: StyleKey<Int64> = StyleKey<Int64>("shadowOffsetY", {d, s => d.int64Values[1 * 4 + s]}, {d, s, v => d.int64Values[1 * 4 + s] = v}, {_ => ()})
    public static let minWidth: StyleKey<Int64> = StyleKey<Int64>("minWidth", {d, s => d.int64Values[2 * 4 + s]}, {d, s, v => d.int64Values[2 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let minHeight: StyleKey<Int64> = StyleKey<Int64>("minHeight", {d, s => d.int64Values[3 * 4 + s]}, {d, s, v => d.int64Values[3 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let layoutWeight: StyleKey<Int64> = StyleKey<Int64>("layoutWeight", {d, s => d.int64Values[4 * 4 + s]}, {d, s, v => d.int64Values[4 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let paddingLeft: StyleKey<Int64> = StyleKey<Int64>("paddingLeft", {d, s => d.int64Values[5 * 4 + s]}, {d, s, v => d.int64Values[5 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let paddingTop: StyleKey<Int64> = StyleKey<Int64>("paddingTop", {d, s => d.int64Values[6 * 4 + s]}, {d, s, v => d.int64Values[6 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let paddingRight: StyleKey<Int64> = StyleKey<Int64>("paddingRight", {d, s => d.int64Values[7 * 4 + s]}, {d, s, v => d.int64Values[7 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let paddingBottom: StyleKey<Int64> = StyleKey<Int64>("paddingBottom", {d, s => d.int64Values[8 * 4 + s]}, {d, s, v => d.int64Values[8 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let gap: StyleKey<Int64> = StyleKey<Int64>("gap", {d, s => d.int64Values[9 * 4 + s]}, {d, s, v => d.int64Values[9 * 4 + s] = v}, {value => if (let StyleValue.Value(v) <- value) { if (v < 0) { throw IllegalArgumentException("negative cells") } }})
    public static let textAlign: StyleKey<Alignment> = StyleKey<Alignment>("textAlign", {d, s => d.alignmentValues[0 * 4 + s]}, {d, s, v => d.alignmentValues[0 * 4 + s] = v}, {value => if (let StyleValue.Value(Alignment.Stretch) <- value) { throw IllegalArgumentException("invalid alignment") }})
    public static let alignItems: StyleKey<Alignment> = StyleKey<Alignment>("alignItems", {d, s => d.alignmentValues[1 * 4 + s]}, {d, s, v => d.alignmentValues[1 * 4 + s] = v}, {_ => ()})
    public static let justifyContent: StyleKey<Alignment> = StyleKey<Alignment>("justifyContent", {d, s => d.alignmentValues[2 * 4 + s]}, {d, s, v => d.alignmentValues[2 * 4 + s] = v}, {value => if (let StyleValue.Value(Alignment.Stretch) <- value) { throw IllegalArgumentException("invalid alignment") }})
    public static let width: StyleKey<Dimension> = StyleKey<Dimension>("width", {d, s => d.dimensionValues[0 * 4 + s]}, {d, s, v => d.dimensionValues[0 * 4 + s] = v}, {value => if (let StyleValue.Value(Dimension.Cells(v)) <- value) { if (v < 0) { throw IllegalArgumentException("negative dimension") } }})
    public static let height: StyleKey<Dimension> = StyleKey<Dimension>("height", {d, s => d.dimensionValues[1 * 4 + s]}, {d, s, v => d.dimensionValues[1 * 4 + s] = v}, {value => if (let StyleValue.Value(Dimension.Cells(v)) <- value) { if (v < 0) { throw IllegalArgumentException("negative dimension") } }})
    public static let border: StyleKey<BorderStyle> = StyleKey<BorderStyle>("border", {d, s => d.borderstyleValues[0 * 4 + s]}, {d, s, v => d.borderstyleValues[0 * 4 + s] = v}, {_ => ()})
    public static let textWrap: StyleKey<TextWrap> = StyleKey<TextWrap>("textWrap", {d, s => d.textwrapValues[0 * 4 + s]}, {d, s, v => d.textwrapValues[0 * 4 + s] = v}, {_ => ()})
    public static let textOverflow: StyleKey<TextOverflow> = StyleKey<TextOverflow>("textOverflow", {d, s => d.textoverflowValues[0 * 4 + s]}, {d, s, v => d.textoverflowValues[0 * 4 + s] = v}, {_ => ()})
}
