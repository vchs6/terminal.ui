diff --git a/tests/rich-text/src/sgr.cj b/tests/rich-text/src/sgr.cj
new file mode 100644
index 0000000..9ce6b49
--- /dev/null
+++ b/tests/rich-text/src/sgr.cj
@@ -0,0 +1,67 @@
+package rich_text_contract
+
+import cjtui.*
+
+func sgrContract(): Unit {
+    ansiCase("", RichText(""), [], "empty stream")
+    ansiCase("A\u{1b}[31mR\u{1b}[0mZ", RichText([TextSpan("A"),
+        TextSpan("R", style: TextStylePatch(foreground: Some(Color.Red))), TextSpan("Z", style: resetPatch())]),
+        [], "unset then red then explicit reset")
+    let colors = [Color.Black, Color.Red, Color.Green, Color.Yellow, Color.Blue, Color.Magenta, Color.Cyan, Color.White,
+        Color.BrightBlack, Color.BrightRed, Color.BrightGreen, Color.BrightYellow, Color.BrightBlue,
+        Color.BrightMagenta, Color.BrightCyan, Color.BrightWhite]
+    for (i in 0..16) {
+        let fg = if (i < 8) { 30 + i } else { 90 + i - 8 }
+        let bg = if (i < 8) { 40 + i } else { 100 + i - 8 }
+        ansiCase("\u{1b}[${fg};${bg}mX", RichText([TextSpan("X",
+            style: TextStylePatch(foreground: Some(colors[i]), background: Some(colors[i])))]), [],
+            "all sixteen foreground/background colors ${i}")
+    }
+    let enable = ["1", "2", "3", "4", "7", "9"]
+    let patches = [TextStylePatch(bold: Some(true)), TextStylePatch(dim: Some(true)),
+        TextStylePatch(italic: Some(true)), TextStylePatch(underline: Some(true)),
+        TextStylePatch(inverse: Some(true)), TextStylePatch(strikethrough: Some(true))]
+    for (i in 0..enable.size) {
+        ansiCase("\u{1b}[${enable[i]}mX", RichText([TextSpan("X", style: patches[i])]), [], "enable SGR ${enable[i]}")
+    }
+    let off = ["22", "23", "24", "27", "29", "39", "49"]
+    let offPatches = [TextStylePatch(bold: Some(false), dim: Some(false)), TextStylePatch(italic: Some(false)),
+        TextStylePatch(underline: Some(false)), TextStylePatch(inverse: Some(false)),
+        TextStylePatch(strikethrough: Some(false)), TextStylePatch(foreground: Some(Color.Default)),
+        TextStylePatch(background: Some(Color.Default))]
+    for (i in 0..off.size) {
+        ansiCase("\u{1b}[${off[i]}mX", RichText([TextSpan("X", style: offPatches[i])]), [], "disable/reset SGR ${off[i]}")
+    }
+    for (sgr in ["", "0", ";", "0;", ";0"]) {
+        ansiCase("\u{1b}[${sgr}mX", RichText([TextSpan("X", style: resetPatch())]), [], "empty top fields reset ${sgr}")
+    }
+    for (channel in [0, 1, 127, 255]) {
+        ansiCase("\u{1b}[38;5;${channel};48;5;${channel}mX", RichText([TextSpan("X",
+            style: TextStylePatch(foreground: Some(Color.Indexed(UInt8(channel))),
+                background: Some(Color.Indexed(UInt8(channel)))))]), [], "indexed endpoints ${channel}")
+    }
+    ansiCase("\u{1b}[38;2;0;128;255;48;2;255;1;0mX", RichText([TextSpan("X",
+        style: TextStylePatch(foreground: Some(Color.Rgb(0, 128, 255)),
+            background: Some(Color.Rgb(255, 1, 0))))]), [], "RGB typed channels")
+    ansiCase("\u{1b}[1;2;3;4;7;9;22;23;24;27;29mX", RichText([TextSpan("X",
+        style: TextStylePatch(bold: Some(false), dim: Some(false), italic: Some(false),
+            underline: Some(false), inverse: Some(false), strikethrough: Some(false)))]), [], "on then off atomic mapping")
+    ansiCase("\u{1b}[;31mX", RichText([TextSpan("X", style: TextStylePatch(foreground: Some(Color.Red),
+        background: Some(Color.Default), bold: Some(false), dim: Some(false), italic: Some(false),
+        underline: Some(false), inverse: Some(false), strikethrough: Some(false)))]), [], "reset then red in same sequence")
+    // Unknown/invalid suffix must discard even valid leading operations.
+    let unknown = ["1;999", "31:1", "?31", "31 ", "38;3;1", "48;4", "1;999;38;5;"]
+    for (params in unknown) {
+        ansiCase("\u{1b}[32mA\u{1b}[${params}mB", RichText([TextSpan("AB",
+            style: TextStylePatch(foreground: Some(Color.Green)))]),
+            [(AnsiTextIssue.UnsupportedSequence, 6)], "atomic unsupported ${params}")
+    }
+    let malformed = ["38", "48", "38;5", "48;2;1;2", "38;5;", "38;2;1;;3", "48;;1", "38;5;256",
+        "48;2;1;999;3", "38;2;1;2;", "38;5;;999"]
+    for (params in malformed) {
+        ansiCase("\u{1b}[32mA\u{1b}[1;${params}mB", RichText([TextSpan("AB",
+            style: TextStylePatch(foreground: Some(Color.Green)))]),
+            [(AnsiTextIssue.MalformedSequence, 6)], "atomic malformed ${params}")
+    }
+    println("PASS: complete SGR whitelist, reset and atomic first-error goldens")
+}
diff --git a/tests/rich-text/src/unsupported.cj b/tests/rich-text/src/unsupported.cj
new file mode 100644
index 0000000..f0c6ea2
--- /dev/null
+++ b/tests/rich-text/src/unsupported.cj
@@ -0,0 +1,33 @@
+package rich_text_contract
+
+import cjtui.*
+
+func unsupportedContract(): Unit {
+    for (sequence in ["\u{1b}[2J", "\u{1b}[3;4H", "\u{1b}[2K", "\u{1b}[?25h", "\u{1b}[6n", "\u{1b}(B",
+        "\u{1b}7", "\u{1b}[1$m", "\u{1b}[1:2m"]) {
+        ansiCase("A" + sequence + "B", RichText("AB"), [(AnsiTextIssue.UnsupportedSequence, 1)],
+            "unknown control stripped without terminal action")
+    }
+    for (sequence in ["\u{1b}[1 2m", "\u{1b}[1\tm", "\u{1b}[1\u{18}2m", "\u{1b}(\u{1}B"]) {
+        ansiCase("A" + sequence + "B", RichText("AB"), [(AnsiTextIssue.MalformedSequence, 1)],
+            "malformed control drained to final")
+    }
+    ansiCase("A\u{1b}[12\u{1b}[31mB", RichText([TextSpan("A"),
+        TextSpan("B", style: TextStylePatch(foreground: Some(Color.Red)))]),
+        [(AnsiTextIssue.MalformedSequence, 1)], "new ESC cancels non-string residual then starts sequence")
+    ansiCase("A\u{1b}[1234\u{1b}[31mB", RichText([TextSpan("A"),
+        TextSpan("B", style: TextStylePatch(foreground: Some(Color.Red)))]),
+        [(AnsiTextIssue.SequenceTooLong, 1)], "new ESC does not duplicate existing first fault")
+    ansiCase("A\u{1b}[1 2\u{1b}[31mB", RichText([TextSpan("A"),
+        TextSpan("B", style: TextStylePatch(foreground: Some(Color.Red)))]),
+        [(AnsiTextIssue.MalformedSequence, 1)], "new ESC does not duplicate prior syntax fault")
+    ansiCase("A\u{1b}[1 2", RichText("A"),
+        [(AnsiTextIssue.MalformedSequence, 1), (AnsiTextIssue.IncompleteSequence, 1)],
+        "finish adds incomplete after first syntax fault")
+    for (residual in ["\u{1b}", "\u{1b}(", "\u{1b}[", "\u{1b}[31", "\u{9b}31"]) {
+        ansiCase("A" + residual, RichText("A"), [(AnsiTextIssue.IncompleteSequence, 1)],
+            "finish consumes residual and closes")
+    }
+    ansiCase("A\r", RichText("A"), [(AnsiTextIssue.UnsupportedSequence, 1)], "finish discards lone CR")
+    println("PASS: unknown and malformed escape framing and finish")
+}
diff --git a/tests/rich-text/src/utf8.cj b/tests/rich-text/src/utf8.cj
new file mode 100644
index 0000000..14e96ee
--- /dev/null
+++ b/tests/rich-text/src/utf8.cj
@@ -0,0 +1,39 @@
+package rich_text_contract
+
+import cjtui.*
+
+func utf8Contract(): Unit {
+    let red = RichText([TextSpan("X", style: TextStylePatch(foreground: Some(Color.Red)))])
+    everySplit([UInt8(0x9b), UInt8(0x33), UInt8(0x31), UInt8(0x6d), UInt8(0x58)], red, [], "raw C1 CSI")
+    everySplit([UInt8(0xc2), UInt8(0x9b), UInt8(0x33), UInt8(0x31), UInt8(0x6d), UInt8(0x58)], red, [], "UTF8 C1 CSI")
+    ansiCase("қ31mЖ\u{1b}[31m界👩\u{200d}💻", RichText([TextSpan("қ31mЖ"),
+        TextSpan("界👩\u{200d}💻", style: TextStylePatch(foreground: Some(Color.Red)))]), [],
+        "D2 9B continuation remains text and never CSI")
+    // U+049C = D2 9C, so its continuation must not terminate this OSC.
+    everySplit([UInt8(0x41), UInt8(0x1b), UInt8(0x5d), UInt8(0xd2), UInt8(0x9c), UInt8(0x58), UInt8(0x07), UInt8(0x42)], RichText("AB"),
+        [(AnsiTextIssue.UnsupportedSequence, 1)], "OSC UTF8 continuation is not ST")
+    for (tail in [[UInt8(0x9c)], [UInt8(0xc2), UInt8(0x9c)], [UInt8(0x1b), UInt8(0x5c)]]) {
+        let bytes = [UInt8(0x41), UInt8(0x9d), UInt8(0x78)].concat(tail).concat([UInt8(0x42)])
+        everySplit(bytes, RichText("AB"), [(AnsiTextIssue.UnsupportedSequence, 1)], "all ST scalar forms")
+    }
+    ansiCase("界\u{9b}2JX\u{7}Y", RichText("界XY"),
+        [(AnsiTextIssue.UnsupportedSequence, 3), (AnsiTextIssue.UnsupportedSequence, 8)], "absolute offsets count UTF8 bytes")
+    ansiCase("A\r\nB\rC\tD\u{8}E\u{7f}F\u{85}G", RichText("A\r\nBCDEFG"),
+        [(AnsiTextIssue.UnsupportedSequence, 4), (AnsiTextIssue.UnsupportedSequence, 6),
+         (AnsiTextIssue.UnsupportedSequence, 8), (AnsiTextIssue.UnsupportedSequence, 10),
+         (AnsiTextIssue.UnsupportedSequence, 12)], "CRLF and rejected scalar controls")
+    for (value in 0..32) {
+        if (value == 10 || value == 13 || value == 27) { continue }
+        everySplit([UInt8(0x41), UInt8(value), UInt8(0x42)], RichText("AB"),
+            [(AnsiTextIssue.UnsupportedSequence, 1)], "all isolated C0 ${value}")
+    }
+    for (value in 128..160) {
+        // Introducers begin incomplete sequences; tested separately with their own rules.
+        if (value == 144 || value == 152 || value == 155 || value == 157 || value == 158 || value == 159) { continue }
+        everySplit([UInt8(0x41), UInt8(value), UInt8(0x42)], RichText("AB"),
+            [(AnsiTextIssue.UnsupportedSequence, 1)], "all isolated raw C1 ${value}")
+        everySplit([UInt8(0x41), UInt8(0xc2), UInt8(value), UInt8(0x42)], RichText("AB"),
+            [(AnsiTextIssue.UnsupportedSequence, 1)], "all isolated UTF8 C1 ${value}")
+    }
+    println("PASS: every UTF8/C1 split, scalar boundaries and literal byte offsets")
+}
