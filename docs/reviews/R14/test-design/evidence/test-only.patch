+        .background(Color.Blue).dim(true), 4, 1)
+    let expected = Style(foreground: Color.Green, background: Color.Blue, bold: false, dim: true)
+    cell(high, 0, 0, "e\u{301}", 1, false, expected, "component explicit fields outrank span patch")
+    cell(high, 1, 0, "界", 2, false, expected, "inherited fields still fill unset span")
+    cell(high, 2, 0, "", 0, true, expected, "component wide continuation style")
+    let low = Frame(4, 1)
+    low.put(0, 0, rich, style: Style(foreground: Color.Green, background: Color.Blue, dim: true))
+    cell(low, 0, 0, "e\u{301}", 1, false, Style(foreground: Color.Red, background: Color.Blue, bold: true, dim: true),
+        "Frame base has lower precedence than span")
+    let same = render(Text(rich).background(Color.Blue).dim(true), 4, 1)
+    let sameLow = Frame(4, 1)
+    sameLow.put(0, 0, rich, style: Style(background: Color.Blue, dim: true))
+    for (x in 0..3) {
+        let a = same.cellAt(x, 0)
+        let b = sameLow.cellAt(x, 0)
+        check(a.grapheme == b.grapheme && a.width == b.width && a.continuation == b.continuation && a.style == b.style,
+            "same base high and low paths agree for cell ${x}")
+    }
+    // Explicit false must suppress only the chosen attribute, retaining the other span fields.
+    let selective = render(Text(RichText([TextSpan("X", style: TextStylePatch(foreground: Some(Color.Red),
+        background: Some(Color.Yellow), bold: Some(true), italic: Some(true), underline: Some(true),
+        inverse: Some(true), strikethrough: Some(true)))] )).foreground(Color.Cyan).bold(false), 1, 1)
+    cell(selective, 0, 0, "X", 1, false, Style(foreground: Color.Cyan, background: Color.Yellow,
+        italic: true, underline: true, inverse: true, strikethrough: true), "explicit override preserves other span attributes")
+    check(render(Text(RichText([TextSpan("A\r"), TextSpan("\nB")])), 2, 2).toPlainText() == "A \nB ",
+        "component whole-document CRLF measurement and paint")
+    check(render(Row { Text(RichText("界")); Text("X") }, 3, 1).toPlainText() == "界X",
+        "typed measurement shares ordinary layout")
+    let wrapped = render(Text(RichText([TextSpan("A界", style: TextStylePatch(foreground: Some(Color.Red))),
+        TextSpan("B")])).width(2), 2, 2)
+    // Existing Text clips by rows rather than enabling a new rich-text-only wrapping policy.
+    check(wrapped.toPlainText() == "A \n  ", "typed text keeps String overflow policy")
+    let nonText = Column { Text("x") }
+    uiError("InvalidProperty", { => nonText.text(RichText("bad")); () }, "RichText setter rejects non-Text")
+    uiError("InvalidProperty", { => nonText.text({ => RichText("bad") }); () }, "RichText getter rejects non-Text")
+    println("PASS: component/Frame precedence and shared measurement")
+}
diff --git a/tests/rich-text/src/control_strings.cj b/tests/rich-text/src/control_strings.cj
new file mode 100644
index 0000000..ff7ecdf
--- /dev/null
+++ b/tests/rich-text/src/control_strings.cj
@@ -0,0 +1,55 @@
+package rich_text_contract
+
+import cjtui.*
+
+func controlStringContract(): Unit {
+    let green = RichText([TextSpan("AB", style: TextStylePatch(foreground: Some(Color.Green)))])
+    // All control strings: OSC has BEL or ST; DCS/SOS/PM/APC have only ST.
+    let introductions = ["\u{1b}]", "\u{1b}P", "\u{1b}X", "\u{1b}^", "\u{1b}_",
+        "\u{9d}", "\u{90}", "\u{98}", "\u{9e}", "\u{9f}"]
+    for (i in 0..introductions.size) {
+        let intro = introductions[i]
+        let osc = i == 0 || i == 5
+        let terminators = if (osc) { ["\u{7}", "\u{1b}\\", "\u{9c}"] } else { ["\u{1b}\\", "\u{9c}"] }
+        for (terminator in terminators) {
+            let payload = if (osc) { "secretҜ\u{1b}[31m\u{18}\u{1a}\u{1b}Ztail" }
+                else { "secretҜ\u{7}\u{1b}[31m\u{18}\u{1a}\u{1b}Ztail" }
+            ansiCase("\u{1b}[32mA" + intro + payload + terminator + "B", green,
+                [(AnsiTextIssue.UnsupportedSequence, 6)], "bounded nested control string ${i}")
+            ansiCase("\u{1b}[32mA" + intro + payload + terminator + "B", green,
+                [(AnsiTextIssue.SequenceTooLong, 6)], "overlong string retains isolation ${i}",
+                limits: AnsiTextLimits(maxSequenceBytes: 8))
+        }
+        ansiCase("A" + intro + "payload\u{18}\u{1a}\u{1b}[31m", RichText("A"),
+            [(AnsiTextIssue.IncompleteSequence, 1)], "finish discards unfinished control payload ${i}")
+        ansiCase("A" + intro + "payload\u{18}\u{1a}\u{1b}[31m", RichText("A"),
+            [(AnsiTextIssue.SequenceTooLong, 1), (AnsiTextIssue.IncompleteSequence, 1)],
+            "overlong unfinished string reports only first resource plus incomplete ${i}",
+            limits: AnsiTextLimits(maxSequenceBytes: 4))
+    }
+    // Raw C1 forms exercise scalar-boundary framing independently of String input.
+    for (intro in [UInt8(0x90), UInt8(0x98), UInt8(0x9d), UInt8(0x9e), UInt8(0x9f)]) {
+        everySplit([UInt8(0x41), intro, UInt8(0x78), UInt8(0x1b), UInt8(0x5b), UInt8(0x33), UInt8(0x31), UInt8(0x6d), UInt8(0x18), UInt8(0x1a), UInt8(0x9c), UInt8(0x42)],
+            RichText("AB"), [(AnsiTextIssue.UnsupportedSequence, 1)], "raw C1 string ${intro}")
+    }
+    ansiCase("A\u{1b}Ppayload\u{7}LEAK\u{1b}\\B", RichText("AB"),
+        [(AnsiTextIssue.UnsupportedSequence, 1)], "DCS BEL cannot end isolation")
+    ansiCase("A\u{1b}]payload\u{1b}\u{1b}\\B", RichText("AB"),
+        [(AnsiTextIssue.UnsupportedSequence, 1)], "nested ESC still recognizes following ST")
+    let long = AnsiTextDecoder()
+    let actual = DecodedStream()
+    actual.append(long.feed(("A\u{1b}P" + repeated("x", 4094)).toArray()))
+    let firstOver = long.feed(repeated("x", 1024).toArray())
+    check(firstOver.diagnostics.size == 1 && firstOver.diagnostics[0].kind == AnsiTextIssue.SequenceTooLong &&
+        firstOver.diagnostics[0].offset == 1, "large DCS reports once after exact budget")
+    actual.append(firstOver)
+    for (_ in 0..128) {
+        let drained = long.feed((repeated("x", 1024) + "\u{1b}[31m\u{18}\u{1a}\u{7}").toArray())
+        check(drained.spans.isEmpty() && drained.diagnostics.isEmpty(), "long failed DCS stays isolated across later feeds")
+        actual.append(drained)
+    }
+    actual.append(long.feed("\u{1b}\\Z".toArray()))
+    actual.append(long.finish())
+    actual.verify(RichText("AZ"), [(AnsiTextIssue.SequenceTooLong, 1)], "long control string drain does not leak")
+    println("PASS: OSC/DCS/SOS/PM/APC bounded drain and legal terminators")
+}
diff --git a/tests/rich-text/src/decoded_stream.cj b/tests/rich-text/src/decoded_stream.cj
new file mode 100644
index 0000000..433b0f1
--- /dev/null
+++ b/tests/rich-text/src/decoded_stream.cj
@@ -0,0 +1,24 @@
+package rich_text_contract
+
+import cjtui.*
+import std.collection.ArrayList
+
+// Test accumulator only: no parsing, style resolution, width or escape logic.
+class DecodedStream {
+    let spans = ArrayList<TextSpan>()
+    let issues = ArrayList<AnsiTextDiagnostic>()
+
+    func append(batch: AnsiTextBatch): Unit {
+        for (span in batch.spans) { spans.add(span) }
+        for (issue in batch.diagnostics) { issues.add(issue) }
+    }
+
+    func verify(expected: RichText, expectedIssues: Array<(AnsiTextIssue, Int64)>, name: String): Unit {
+        check(RichText(spans.toArray()) == expected, "${name}: normalized literal spans")
+        check(issues.size == expectedIssues.size, "${name}: issue count ${issues.size}/${expectedIssues.size}")
+        for (i in 0..expectedIssues.size) {
+            check(issues[i].kind == expectedIssues[i][0] && issues[i].offset == expectedIssues[i][1],
+                "${name}: diagnostic ${i} kind and absolute byte offset")
+        }
+    }
+}
diff --git a/tests/rich-text/src/decoder_assertions.cj b/tests/rich-text/src/decoder_assertions.cj
new file mode 100644
index 0000000..764cbba
--- /dev/null
+++ b/tests/rich-text/src/decoder_assertions.cj
@@ -0,0 +1,54 @@
+package rich_text_contract
+
+import cjtui.*
+
+func repeated(value: String, count: Int64): String {
+    var result = ""
+    for (_ in 0..count) { result += value }
+    result
+}
+
+func resetPatch(): TextStylePatch {
+    TextStylePatch(foreground: Some(Color.Default), background: Some(Color.Default),
+        bold: Some(false), dim: Some(false), italic: Some(false), underline: Some(false),
+        inverse: Some(false), strikethrough: Some(false))
+}
+
+func decodeCuts(bytes: Array<UInt8>, cuts: Array<Int64>, expected: RichText,
+    issues: Array<(AnsiTextIssue, Int64)>, name: String, limits!: AnsiTextLimits = AnsiTextLimits()): Unit {
+    let decoder = AnsiTextDecoder(limits: limits)
+    let actual = DecodedStream()
+    var start = 0
+    for (end in cuts) {
+        actual.append(decoder.feed(bytes.slice(start, end - start)))
+        start = end
+    }
+    actual.append(decoder.feed(bytes.slice(start, bytes.size - start)))
+    actual.append(decoder.finish())
+    actual.verify(expected, issues, name)
+    ansiError("DecoderClosed", { => decoder.feed(Array<UInt8>()); () }, "${name}: feed after finish")
+    ansiError("DecoderClosed", { => decoder.finish(); () }, "${name}: finish after finish")
+}
+
+// Each expected result is supplied by the test author, never by another decoder call.
+// Enumerate every two-chunk boundary, plus an entirely bytewise stream and empty chunks.
+func everySplit(bytes: Array<UInt8>, expected: RichText, issues: Array<(AnsiTextIssue, Int64)>, name: String,
+    limits!: AnsiTextLimits = AnsiTextLimits()): Unit {
+    for (cut in 0..(bytes.size + 1)) {
+        decodeCuts(bytes, [cut], expected, issues, "${name} split ${cut}", limits: limits)
+    }
+    let byteCuts = Array<Int64>(bytes.size + 1, {i => i})
+    decodeCuts(bytes, byteCuts, expected, issues, "${name} bytewise", limits: limits)
+    decodeCuts(bytes, [0, 0, bytes.size, bytes.size], expected, issues, "${name} empty chunks", limits: limits)
+}
+
+func ansiCase(source: String, expected: RichText, issues: Array<(AnsiTextIssue, Int64)>, name: String,
+    limits!: AnsiTextLimits = AnsiTextLimits()): Unit {
+    everySplit(source.toArray(), expected, issues, name, limits: limits)
+    let result = parseAnsiText(source, limits: limits)
+    check(result.text == expected && result.diagnostics.size == issues.size, "${name}: one-shot literal golden")
+    for (i in 0..issues.size) {
+        check(result.diagnostics[i].kind == issues[i][0] && result.diagnostics[i].offset == issues[i][1],
+            "${name}: one-shot issue ${i}")
+    }
+}
diff --git a/tests/rich-text/src/invalid_utf8.cj b/tests/rich-text/src/invalid_utf8.cj
new file mode 100644
index 0000000..4956377
--- /dev/null
+++ b/tests/rich-text/src/invalid_utf8.cj
@@ -0,0 +1,37 @@
+package rich_text_contract
+
+import cjtui.*
+
+// Exception streams deliberately assert only code and fail-close. Prefix batches
+// already delivered before the failure may differ with chunk boundaries by contract.
+func invalidSplits(bytes: Array<UInt8>, name: String): Unit {
+    for (cut in 0..(bytes.size + 1)) {
+        let decoder = AnsiTextDecoder()
+        let actual = ["no exception"]
+        try {
+            decoder.feed(bytes.slice(0, cut))
+            decoder.feed(bytes.slice(cut, bytes.size - cut))
+            decoder.finish()
+        } catch (error: AnsiTextException) { actual[0] = error.code }
+        check(actual[0] == "InvalidUtf8", "${name}: same error code at split ${cut}")
+        ansiError("DecoderClosed", { => decoder.feed("safe".toArray()); () }, "invalid UTF8 permanently closes feed")
+        ansiError("DecoderClosed", { => decoder.finish(); () }, "invalid UTF8 permanently closes finish")
+    }
+}
+
+func invalidUtf8Contract(): Unit {
+    let invalid: Array<Array<UInt8>> = [[UInt8(0xff)], [UInt8(0xc0), UInt8(0xaf)], [UInt8(0xc1), UInt8(0xbf)], [UInt8(0xe0), UInt8(0x80), UInt8(0x80)],
+        [UInt8(0xed), UInt8(0xa0), UInt8(0x80)], [UInt8(0xf0), UInt8(0x80), UInt8(0x80), UInt8(0x80)], [UInt8(0xf4), UInt8(0x90), UInt8(0x80), UInt8(0x80)],
+        [UInt8(0xf5), UInt8(0x80), UInt8(0x80), UInt8(0x80)], [UInt8(0xe2), UInt8(0x28), UInt8(0xa1)], [UInt8(0xd2), UInt8(0x41)], [UInt8(0xa0)], [UInt8(0xbf)]]
+    for (bytes in invalid) {
+        invalidSplits(bytes, "invalid scalar")
+        invalidSplits([UInt8(0x41)].concat(bytes), "valid prefix then invalid scalar")
+        invalidSplits([UInt8(0x1b), UInt8(0x5d), UInt8(0x78)].concat(bytes).concat([UInt8(0x07)]), "invalid UTF8 in OSC")
+        invalidSplits([UInt8(0x1b), UInt8(0x50), UInt8(0x78)].concat(bytes).concat([UInt8(0x1b), UInt8(0x5c)]), "invalid UTF8 in DCS")
+    }
+    for (pending in [[UInt8(0xc2)], [UInt8(0xe2), UInt8(0x82)], [UInt8(0xf0), UInt8(0x9f), UInt8(0x92)]]) {
+        invalidSplits(pending, "finish rejects truncated UTF8")
+        invalidSplits([UInt8(0x1b), UInt8(0x5d)].concat(pending), "finish rejects truncated UTF8 in control string")
+    }
+    println("PASS: InvalidUtf8 error codes and permanent closure for every split")
+}
diff --git a/tests/rich-text/src/limits.cj b/tests/rich-text/src/limits.cj
new file mode 100644
index 0000000..61ec746
--- /dev/null
+++ b/tests/rich-text/src/limits.cj
@@ -0,0 +1,91 @@
+package rich_text_contract
+
+import cjtui.*
+
+func limitContract(): Unit {
+    check(AnsiTextLimits().maxSequenceBytes == 4096 && AnsiTextLimits().maxParameters == 64,
+        "published default limits use maxParameters for all CSI")
+    for (value in [Int64(-1), 0, 1048577]) {
+        illegal({ => AnsiTextLimits(maxSequenceBytes: value); () }, "sequence limit range")
+    }
+    for (value in [Int64(-1), 0, 4097]) {
+        illegal({ => AnsiTextLimits(maxParameters: value); () }, "parameter limit range")
+    }
+    let ceiling = AnsiTextLimits(maxSequenceBytes: 1048576, maxParameters: 4096)
+    check(ceiling.maxSequenceBytes == 1048576 && ceiling.maxParameters == 4096, "inclusive upper limits")
+    for (fields in [Int64(63), 64, 65]) {
+        let params = repeated(";", fields - 1)
+        let expected = if (fields <= 64) { RichText([TextSpan("X", style: resetPatch())]) } else { RichText("X") }
+        let issues: Array<(AnsiTextIssue, Int64)> = if (fields <= 64) { [] } else { [(AnsiTextIssue.SequenceTooLong, 0)] }
+        ansiCase("\u{1b}[${params}mX", expected, issues, "63/64/65 SGR fields ${fields}")
+        let unknownIssues = if (fields <= 64) { [(AnsiTextIssue.UnsupportedSequence, Int64(0))] }
+            else { [(AnsiTextIssue.SequenceTooLong, Int64(0))] }
+        ansiCase("\u{1b}[${params}KX", RichText("X"), unknownIssues, "parameter limit applies to non-m ${fields}")
+    }
+    // Extended color operands and empty fields all consume parameter slots.
+    ansiCase("\u{1b}[38;2;1;2;3mX", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "RGB operand field budget", limits: AnsiTextLimits(maxParameters: 4))
+    ansiCase("\u{1b}[;mX", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "empty fields consume budget", limits: AnsiTextLimits(maxParameters: 1))
+    ansiCase("\u{1b}[mX", RichText([TextSpan("X", style: resetPatch())]), [],
+        "no parameter is one implicit zero", limits: AnsiTextLimits(maxParameters: 1))
+    for (finalByte in ["m", "K"]) {
+        ansiCase("\u{1b}[123${finalByte}X", RichText("X"), [(AnsiTextIssue.UnsupportedSequence, 0)],
+            "three-digit token allowed ${finalByte}")
+        ansiCase("\u{1b}[0000${finalByte}X", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+            "four-digit token resource before final ${finalByte}")
+    }
+    // At 4095/4096/4097 the introducer and terminating BEL are included.
+    for (length in [Int64(4095), 4096, 4097]) {
+        let bytes = ("A\u{1b}]" + repeated("x", length - 3) + "\u{7}B").toArray()
+        let kind = if (length <= 4096) { AnsiTextIssue.UnsupportedSequence } else { AnsiTextIssue.SequenceTooLong }
+        decodeCuts(bytes, [0, 1, 2, 3, 4095, 4096], RichText("AB"), [(kind, 1)], "sequence bytes ${length}")
+        decodeCuts(bytes, Array<Int64>(bytes.size + 1, {i => i}), RichText("AB"), [(kind, 1)],
+            "sequence bytes ${length} bytewise")
+    }
+    let red = RichText([TextSpan("X", style: TextStylePatch(foreground: Some(Color.Red)))])
+    everySplit([UInt8(0x9b), UInt8(0x33), UInt8(0x31), UInt8(0x6d), UInt8(0x58)], red, [], "raw CSI actual bytes four",
+        limits: AnsiTextLimits(maxSequenceBytes: 4))
+    everySplit([UInt8(0xc2), UInt8(0x9b), UInt8(0x33), UInt8(0x31), UInt8(0x6d), UInt8(0x58)], RichText("X"),
+        [(AnsiTextIssue.SequenceTooLong, 0)], "UTF8 CSI actual bytes five", limits: AnsiTextLimits(maxSequenceBytes: 4))
+    ansiCase("\u{1b}[31mX", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "ESC CSI actual bytes five", limits: AnsiTextLimits(maxSequenceBytes: 4))
+    ansiCase("\u{1b}[1mX", RichText([TextSpan("X", style: TextStylePatch(bold: Some(true)))]), [],
+        "terminator exactly at byte budget", limits: AnsiTextLimits(maxSequenceBytes: 4))
+    ansiCase("\u{1b}[1mX", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "terminator exceeds byte budget", limits: AnsiTextLimits(maxSequenceBytes: 3))
+    // Resource fault on the same byte wins over malformed ordering/control.
+    ansiCase("\u{1b}[\tmX", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "resource before syntax on same byte", limits: AnsiTextLimits(maxSequenceBytes: 2))
+    ansiCase("\u{1b}[1 2" + repeated("0", 10) + "mX", RichText("X"),
+        [(AnsiTextIssue.MalformedSequence, 0)], "first malformed not overwritten by later resource",
+        limits: AnsiTextLimits(maxSequenceBytes: 8))
+    // Resource issue is delivered immediately, once; finish can add incomplete.
+    let digits = AnsiTextDecoder()
+    let batch = digits.feed("A\u{1b}[1234".toArray())
+    check(batch.diagnostics.size == 1 && batch.diagnostics[0].kind == AnsiTextIssue.SequenceTooLong &&
+        batch.diagnostics[0].offset == 1, "fourth digit reports before any final")
+    check(digits.feed("5;9999".toArray()).diagnostics.isEmpty(), "already failed CSI not reported again")
+    let ending = digits.finish()
+    check(ending.diagnostics.size == 1 && ending.diagnostics[0].kind == AnsiTextIssue.IncompleteSequence &&
+        ending.diagnostics[0].offset == 1, "finish adds incomplete to resource-failed residual")
+    let fields = AnsiTextDecoder(limits: AnsiTextLimits(maxParameters: 2))
+    check(fields.feed("\u{1b}[1;2".toArray()).diagnostics.isEmpty(), "at field budget remains pending")
+    let over = fields.feed(";".toArray())
+    check(over.diagnostics.size == 1 && over.diagnostics[0].kind == AnsiTextIssue.SequenceTooLong,
+        "first excess semicolon reports immediately before unknown final")
+    check(fields.feed("KX".toArray()).diagnostics.isEmpty(), "unknown final cannot replace first resource issue")
+    fields.finish()
+    for (length in [Int64(4095), 4096, 4097]) {
+        let bytes = ("A\u{1b}[" + repeated(" ", length - 3) + "KB").toArray()
+        let kind = if (length <= 4096) { AnsiTextIssue.UnsupportedSequence } else { AnsiTextIssue.SequenceTooLong }
+        decodeCuts(bytes, Array<Int64>(bytes.size + 1, {i => i}), RichText("AB"), [(kind, 1)],
+            "unknown CSI byte boundary ${length}")
+    }
+    everySplit([UInt8(0x9d), UInt8(0x78), UInt8(0x9c), UInt8(0x58)], RichText("X"),
+        [(AnsiTextIssue.UnsupportedSequence, 0)], "raw C1 OSC and ST actual bytes",
+        limits: AnsiTextLimits(maxSequenceBytes: 4))
+    ansiCase("\u{9d}x\u{9c}X", RichText("X"), [(AnsiTextIssue.SequenceTooLong, 0)],
+        "UTF8 C1 OSC and ST actual bytes", limits: AnsiTextLimits(maxSequenceBytes: 4))
+    println("PASS: all-CSI count/token/byte boundaries and immediate first faults")
+}
