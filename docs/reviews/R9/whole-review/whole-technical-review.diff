+        for (i in 0..n.lines.size) {
+            let cy = sat(iy, i)
+            let free = if (n.widths[i] < innerW) {
+                innerW - n.widths[i]
+            } else {
+                0
+            }
+            var cx = sat(ix, offset(c.textAlignment, free))
+            for (g in n.lines[i]) {
+                let gw = displayWidth(g)
+                if (cy < ib && cx < ir && gw <= ir - cx) {
+                    frame.put(cx, cy, g, style: style)
+                }
+                cx = sat(cx, gw)
+            }
+        }
+        return
+    }
+    let mainSize = if (c.kind == 2) {
+        innerW
+    } else {
+        innerH
+    }
+    let cross = if (c.kind == 2) {
+        innerH
+    } else {
+        innerW
+    }
+    let count = n.children.size
+    let sizes = Array<Int64>(count, repeat: 0)
+    let bases = Array<Int64>(count, repeat: 0)
+    let remainders = Array<Int64>(count, repeat: 0)
+    var occupied: Int64 = 0
+    var totalWeight: Int64 = 0
+    var totalBase: Int64 = 0
+    var flexCount: Int64 = 0
+    for (i in 0..count) {
+        let child = n.children[i];
+        let cc = child.component
+        if (i > 0) {
+            occupied = sat(occupied, c.spacing)
+        }
+        let minimum = if (c.kind == 2) {
+            cc.minW
+        } else {
+            cc.minH
+        }
+        if (cc.weight > 0) {
+            if (totalWeight > Int64.Max - cc.weight) {
+                throw IllegalArgumentException("weight sum overflow")
+            }
+            totalWeight += cc.weight
+            flexCount++
+            bases[i] = lesser(minimum, mainSize)
+            if (totalBase > Int64.Max - bases[i]) {
+                throw IllegalArgumentException("minimum sum overflow")
+            }
+            totalBase += bases[i]
+        } else {
+            let desired = if (c.kind == 2) {
+                cc.fixedW ?? child.naturalW
+            } else {
+                cc.fixedH ?? child.naturalH
+            }
+            sizes[i] = lesser(mainSize, greater(desired, minimum))
+            occupied = sat(occupied, sizes[i])
+        }
+    }
+    let pool = if (occupied < mainSize) {
+        mainSize - occupied
+    } else {
+        0
+    }
+    if (flexCount > 0) {
+        let useMin = totalBase > pool
+        let denominator = if (useMin) {
+            totalBase
+        } else {
+            totalWeight
+        }
+        let amount = if (useMin) {
+            pool
+        } else {
+            pool - totalBase
+        }
+        var used: Int64 = 0
+        for (i in 0..count) {
+            let cc = n.children[i].component
+            if (cc.weight > 0) {
+                let basis = if (useMin) {
+                    bases[i]
+                } else {
+                    cc.weight
+                }
+                let (share, rem) = mulDiv(basis, amount, denominator)
+                sizes[i] = share + if (useMin) {
+                    0
+                } else {
+                    bases[i]
+                }
+                remainders[i] = rem
+                used += share
+            }
+        }
+        var remaining = amount - used
+        while (remaining > 0) {
+            var best: Int64 = -1
+            for (i in 0..count) {
+                if (n.children[i].component.weight > 0 && remainders[i] >= 0 && (best < 0 || remainders[i] > remainders[best])) {
+                    best = i
+                }
+            }
+            sizes[best]++;
+            remainders[best] = -1
+            remaining--
+        }
+    }
+    let free = if (flexCount == 0 && occupied < mainSize) {
+        mainSize - occupied
+    } else {
+        0
+    }
+    var cursor = offset(c.justify, free)
+    for (i in 0..count) {
+        let child = n.children[i];
+        let cc = child.component
+        let fixed = if (c.kind == 2) {
+            cc.fixedH
+        } else {
+            cc.fixedW
+        }
+        let minimum = if (c.kind == 2) {
+            cc.minH
+        } else {
+            cc.minW
+        }
+        let natural = if (c.kind == 2) {
+            child.naturalH
+        } else {
+            child.naturalW
+        }
+        var crossSize = lesser(cross, greater(fixed ?? natural, minimum))
+        if (c.align == Alignment.Stretch && fixed == Option<Int64>.None) {
+            crossSize = cross
+        }
+        let crossOffset = offset(c.align, cross - crossSize)
+        let cx = if (c.kind == 2) {
+            sat(ix, cursor)
+        } else {
+            sat(ix, crossOffset)
+        }
+        let cy = if (c.kind == 2) {
+            sat(iy, crossOffset)
+        } else {
+            sat(iy, cursor)
+        }
+        let cw = if (c.kind == 2) {
+            sizes[i]
+        } else {
+            crossSize
+        }
+        let ch = if (c.kind == 2) {
+            crossSize
+        } else {
+            sizes[i]
+        }
+        paint(child, frame, cx, cy, cw, ch, greater(clipL, ix), greater(clipT, iy), ir, ib, style)
+        cursor = sat(cursor, sizes[i])
+        if (i + 1 < count) {
+            cursor = sat(cursor, c.spacing)
+        }
+    }
+}
+
+public func render(root: Component, width: Int64, height: Int64): Frame {
+    let frame = Frame(width, height)
+    let node = LayoutNode(root);
+    node.measure()
+    let w = lesser(width, greater(root.fixedW ?? width, root.minW))
+    let h = lesser(height, greater(root.fixedH ?? height, root.minH))
+    paint(node, frame, 0, 0, w, h, 0, 0, width, height, Style())
+    frame
+}
diff --git a/src/layout_node.cj b/src/layout_node.cj
new file mode 100644
index 0000000..292041a
--- /dev/null
+++ b/src/layout_node.cj
@@ -0,0 +1,68 @@
+package cjtui
+
+import std.collection.ArrayList
+
+class LayoutNode {
+    let component: Component
+    let children = ArrayList<LayoutNode>()
+    let lines = ArrayList<ArrayList<String>>()
+    let widths = ArrayList<Int64>()
+    var naturalW: Int64 = 0
+    var naturalH: Int64 = 0
+    init(c: Component) {
+        component = c
+    }
+    func measure(): Unit {
+        let c = component
+        if (c.kind == 0) {
+            validateText(c.value)
+            var line = ArrayList<String>()
+            var w: Int64 = 0
+            for (g in graphemeClusters(c.value)) {
+                if (g == "\n" || g == "\r\n") {
+                    lines.add(line);
+                    widths.add(w);
+                    naturalW = greater(naturalW, w)
+                    line = ArrayList<String>()
+                    w = 0
+                } else {
+                    line.add(g);
+                    w = sat(w, displayWidth(g))
+                }
+            }
+            lines.add(line);
+            widths.add(w);
+            naturalW = greater(naturalW, w)
+            naturalH = lines.size
+        } else {
+            for (child in c.children) {
+                let n = LayoutNode(child);
+                n.measure();
+                children.add(n)
+                let cw = greater(child.fixedW ?? n.naturalW, child.minW)
+                let ch = greater(child.fixedH ?? n.naturalH, child.minH)
+                if (c.kind == 1) {
+                    naturalW = greater(naturalW, cw)
+                    naturalH = sat(naturalH, ch)
+                } else {
+                    naturalW = sat(naturalW, cw)
+                    naturalH = greater(naturalH, ch)
+                }
+            }
+            for (_ in 1..children.size) {
+                if (c.kind == 1) {
+                    naturalH = sat(naturalH, c.spacing)
+                } else {
+                    naturalW = sat(naturalW, c.spacing)
+                }
+            }
+        }
+        let inset = sat(c.pad, if (c.borderStyle == BorderStyle.None) {
+            0
+        } else {
+            1
+        })
+        naturalW = sat(sat(naturalW, inset), inset)
+        naturalH = sat(sat(naturalH, inset), inset)
+    }
+}
