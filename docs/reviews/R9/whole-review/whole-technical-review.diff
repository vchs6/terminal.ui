+package decoration_contract
+import cjtui.*
+func check(value: Bool, name: String): Unit {
+    if (!value) { throw Exception("FAIL: ${name}") }
+    println("PASS: ${name}")
+}
+func snapshot(frame: Frame, expected: String, name: String): Unit {
+    check(frame.toPlainText() == expected, "${name}: got [${frame.toPlainText()}], want [${expected}]")
+}
+func blank(frame: Frame, x: Int64, y: Int64): Bool {
+    let cell = frame.cellAt(x, y)
+    cell.grapheme == " " && cell.width == 1 && !cell.continuation
+}
+func borders(): Unit {
+    let single = Frame(4, 3)
+    single.drawBorder(Rect(0, 0, 4, 3))
+    snapshot(single, "┌──┐\n│  │\n└──┘", "default single border")
+    let rounded = Frame(4, 3)
+    rounded.drawBorder(Rect(0, 0, 4, 3), border: BorderStyle.Rounded)
+    snapshot(rounded, "╭──╮\n│  │\n╰──╯", "rounded corners")
+    let double = Frame(4, 3)
+    double.drawBorder(Rect(0, 0, 4, 3), border: BorderStyle.Double)
+    snapshot(double, "╔══╗\n║  ║\n╚══╝", "double border")
+    let ascii = Frame(4, 3)
+    ascii.drawBorder(Rect(0, 0, 4, 3), border: BorderStyle.Ascii)
+    snapshot(ascii, "+--+\n|  |\n+--+", "explicit ASCII border")
+    for (style in [BorderStyle.None, BorderStyle.Single, BorderStyle.Rounded, BorderStyle.Double, BorderStyle.Ascii]) {
+        let empty = Frame(3, 2)
+        empty.put(0, 0, "abc\ndef")
+        empty.drawBorder(Rect(0, 0, 0, 2), border: style)
+        empty.drawBorder(Rect(0, 0, 3, 0), border: style)
+        snapshot(empty, "abc\ndef", "empty border leaves existing cells intact")
+    }
+    let none = Frame(3, 2)
+    none.put(0, 0, "abc\ndef")
+    none.drawBorder(Rect(0, 0, 3, 2), border: BorderStyle.None)
+    snapshot(none, "abc\ndef", "None is transparent")
+    for (style in [BorderStyle.Single, BorderStyle.Rounded, BorderStyle.Double, BorderStyle.Ascii]) {
+        let point = Frame(1, 1)
+        point.drawBorder(Rect(0, 0, 1, 1), border: style)
+        snapshot(point, "+", "one-cell border uses ASCII plus")
+    }
+    let vertical = Frame(1, 3)
+    vertical.drawBorder(Rect(0, 0, 1, 3), border: BorderStyle.Double)
+    snapshot(vertical, "║\n║\n║", "width-one border has no overlapping corners")
+    let horizontal = Frame(4, 1)
+    horizontal.drawBorder(Rect(0, 0, 4, 1), border: BorderStyle.Rounded)
+    snapshot(horizontal, "────", "height-one border has no corners")
+    let fallback = Frame(4, 3, ambiguousWide: true)
+    fallback.drawBorder(Rect(0, 0, 4, 3))
+    snapshot(fallback, "+--+\n|  |\n+--+", "non-column-one border glyph triggers whole-set ASCII fallback")
+    let clipped = Frame(4, 3)
+    clipped.drawBorder(Rect(-2, -1, 5, 4))
+    snapshot(clipped, "  │ \n  │ \n──┘ ", "clip original border geometry without inventing new corners")
+}
+func fillsAndSharedClusters(): Unit {
+    let s = Style(foreground: Color.Red, background: Color.Blue, bold: true)
+    let fill = Frame(4, 2)
+    fill.put(0, 0, "abcd\nefgh")
+    fill.fillRect(Rect(1, 0, 2, 2), style: s)
+    snapshot(fill, "a  d\ne  h", "fill writes opaque styled spaces")
+    check(fill.cellAt(1, 0).style == s && fill.cellAt(2, 1).style == s, "fill retains complete style")
+    fill.fillRect(Rect(1, 0, 1, 1))
+    check(fill.cellAt(1, 0).style == Style(), "default fill explicitly resets cell style")
+    let wideFill = Frame(4, 1)
+    wideFill.put(0, 0, "中X")
+    wideFill.fillRect(Rect(1, 0, 1, 1), style: s)
+    snapshot(wideFill, "  X ", "fill over continuation clears full old cluster")
+    check(blank(wideFill, 0, 0) && wideFill.cellAt(1, 0).style == s, "fill shares Frame continuation cleanup")
+    let wideBorder = Frame(4, 1)
+    wideBorder.put(0, 0, "中中")
+    wideBorder.drawBorder(Rect(1, 0, 1, 1), style: s)
+    snapshot(wideBorder, " +中", "border overwriting wide continuation preserves adjacent cluster")
+    check(blank(wideBorder, 0, 0) && wideBorder.cellAt(1, 0).style == s && wideBorder.cellAt(3, 0).continuation, "border shares Frame width and style rules")
+    let wideShadow = Frame(4, 1)
+    wideShadow.put(0, 0, "中X")
+    wideShadow.drawShadow(Rect(0, 0, 1, 1), offsetX: 1, offsetY: 0, style: s)
+    snapshot(wideShadow, " ░X ", "shadow over continuation clears original leading cell")
+    check(blank(wideShadow, 0, 0) && wideShadow.cellAt(1, 0).style == s, "shadow shares cleanup and exact style")
+    wideShadow.put(0, 0, "中")
+    check(wideShadow.cellAt(1, 0).continuation && wideShadow.cellAt(0, 0).width == 2, "subsequent text covers decoration through same Frame path")
+}
+func shadowsAndExtrema(): Unit {
+    for (empty in [Frame(0, 0), Frame(0, Int64.Max), Frame(Int64.Max, 0)]) {
+        empty.fillRect(Rect(Int64.Min, Int64.Min, Int64.Max, Int64.Max))
+        empty.drawBorder(Rect(0, 0, Int64.Max, Int64.Max))
+        empty.drawShadow(Rect(0, 0, Int64.Max, Int64.Max))
+        check(empty.toAnsi() == "", "empty frame with extreme other axis performs no virtual-area iteration")
+    }
+    let f = Frame(5, 3)
+    f.drawShadow(Rect(1, 0, 3, 2))
+    snapshot(f, "     \n    ░\n  ░░░", "positive shadow is shifted rectangle minus original")
+    let negative = Frame(5, 3)
+    negative.drawShadow(Rect(1, 1, 3, 2), offsetX: -1, offsetY: -1)
+    snapshot(negative, "░░░  \n░    \n     ", "negative offsets expose top and left only")
+    let zero = Frame(3, 2)
+    zero.put(0, 0, "abc\ndef")
+    zero.drawShadow(Rect(0, 0, 3, 2), offsetX: 0, offsetY: 0)
+    zero.drawShadow(Rect(0, 0, 0, 2))
+    zero.drawShadow(Rect(0, 0, 3, 0))
+    snapshot(zero, "abc\ndef", "zero offset and empty shadows write nothing")
+    let fallback = Frame(3, 1, ambiguousWide: true)
+    fallback.drawShadow(Rect(0, 0, 1, 1), offsetX: 1, offsetY: 0)
+    check(displayWidth("░", ambiguousWide: true) == 1, "actual public width policy keeps light shade one column")
+    snapshot(fallback, " ░ ", "nonambiguous shadow glyph does not spuriously fall back")
+    let huge = Frame(3, 2)
+    huge.drawBorder(Rect(-1, -1, Int64.Max, Int64.Max))
+    huge.drawBorder(Rect(Int64.Min, 0, Int64.Max, 2))
+    huge.drawBorder(Rect(Int64.Max, Int64.Max, Int64.Max, Int64.Max))
+    snapshot(huge, "   \n   ", "huge offscreen original edges do not become viewport border")
+    huge.drawBorder(Rect(-1, 0, Int64.Max, 1))
+    snapshot(huge, "───\n   ", "huge thin border iterates only visible cells")
+    huge.fillRect(Rect(-1, -1, Int64.Max, Int64.Max), style: Style(background: Color.Green))
+    snapshot(huge, "   \n   ", "huge fill completes after clipping")
+    check(huge.cellAt(2, 1).style.background == Color.Green, "huge fill reaches visible far corner")
+    huge.fillRect(Rect(Int64.Min, 0, Int64.Max, 2), style: Style(background: Color.Red))
+    check(huge.cellAt(0, 0).style.background == Color.Green, "negative extreme right edge stays outside")
+    let shifted = Frame(3, 2)
+    shifted.drawShadow(Rect(Int64.Min, Int64.Min, Int64.Max, Int64.Max), offsetX: Int64.Max, offsetY: Int64.Max)
+    snapshot(shifted, "░░░\n░░░", "extreme offset uses mathematical geometry before clipping")
+    shifted.drawShadow(Rect(0, 0, 3, 2), offsetX: Int64.Max, offsetY: Int64.Max)
+    snapshot(shifted, "░░░\n░░░", "overflowing shifted endpoints stay offscreen")
+}
+func components(): Unit {
+    snapshot(render(Text("X").border(BorderStyle.Rounded), 5, 3), "╭───╮\n│X  │\n╰───╯", "component border reserves content insets")
+    snapshot(render(Text("X").border(BorderStyle.Single).padding(1), 7, 5), "┌─────┐\n│     │\n│ X   │\n│     │\n└─────┘", "border and padding share outer inset path")
+    snapshot(render(Text("X").border(BorderStyle.Single), 1, 1), "+", "tiny component never writes content over border")
+    snapshot(render(Text("X").border(BorderStyle.Double), 1, 3), "║\n║\n║", "tiny vertical component keeps border only")
+    let color = render(Text("X").foreground(Color.Green).border(BorderStyle.Single).borderColor(Color.Red), 4, 3)
+    check(color.cellAt(0, 0).style.foreground == Color.Red && color.cellAt(1, 1).style.foreground == Color.Green, "borderColor changes border without changing text")
+    let inherited = render(Column { Text("X").border(BorderStyle.Single) }.foreground(Color.Cyan), 5, 3)
+    check(inherited.cellAt(0, 0).style.foreground == Color.Cyan, "unset borderColor follows effective node foreground")
+    let panel = [Text("")]
+    let root = Row { panel[0] = Text("A").width(3).height(2).shadow(); Text("B").width(1).height(2) }
+    snapshot(render(root, 5, 3), "A  B \n   ░ \n ░░░ ", "shadow expands paint without affecting sibling layout; unset empty areas stay transparent")
+    panel[0].shadow(enabled: false)
+    snapshot(render(root, 5, 3), "A  B \n     \n     ", "disabled shadow clears previous target area on next complete render")
+    panel[0].shadow(offsetX: 0, offsetY: 0)
+    snapshot(render(root, 5, 3), "A  B \n     \n     ", "zero-offset component shadow remains invisible")
+    let clipped = Column { Text("A").width(3).height(2).shadow(offsetX: -1, offsetY: 1) }.padding(1)
+    snapshot(render(clipped, 6, 4), "      \n A    \n      \n      ", "child shadow obeys ancestor content clip on every side")
+    let opaque = Row { Text("A").width(3).height(2).shadow(); Text("B").width(1).height(2).background(Color.Default) }
+    snapshot(render(opaque, 5, 3), "A  B \n     \n ░░░ ", "explicit Default background fills later sibling and covers shadow")
+    let styled = render(Text("X").padding(1).border(BorderStyle.Single).background(Color.Blue), 5, 5)
+    check(styled.cellAt(0, 0).style.background == Color.Blue && styled.cellAt(1, 1).style.background == Color.Blue && styled.cellAt(2, 2).style.background == Color.Blue, "explicit background fills border padding and content space")
+    let noFill = render(Text("X").width(4).height(2).foreground(Color.Red), 4, 2)
+    check(noFill.cellAt(0, 0).style.foreground == Color.Red && noFill.cellAt(3, 1).style == Style(), "unset background leaves unused allocation untouched")
+    let s = Style(foreground: Color.Red, background: Color.Yellow, bold: true)
+    let exact = render(Row { Text("X").width(2).height(1).shadow(offsetX: 1, offsetY: 1, style: s) }.foreground(Color.Green).background(Color.Blue), 4, 3)
+    check(exact.cellAt(1, 1).style == s, "shadow uses complete explicit style without inheriting parent")
+    let border = Text("X").border(BorderStyle.Single)
+    snapshot(render(border, 4, 3), "┌──┐\n│X │\n└──┘", "border initial frame")
+    border.border(BorderStyle.None)
+    snapshot(render(border, 4, 3), "X   \n    \n    ", "removing border restores content space and clears old border")
+}
+main(): Int64 {
+    borders()
+    fillsAndSharedClusters()
+    shadowsAndExtrema()
+    components()
+    return 0
+}
diff --git a/tests/integration/layout-pty.mjs b/tests/integration/layout-pty.mjs
new file mode 100644
index 0000000..71ef666
--- /dev/null
+++ b/tests/integration/layout-pty.mjs
@@ -0,0 +1,150 @@
+#!/usr/bin/env node
+// Actual public layout example in a Linux PTY. This is test support, not a backend.
+import assert from 'node:assert/strict';
+import { spawn, spawnSync } from 'node:child_process';
+import { mkdtemp, readFile, writeFile, mkdir } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve, join } from 'node:path';
+import { StringDecoder } from 'node:string_decoder';
+
+const binary = resolve(process.argv[2] ?? 'examples/layout/target/release/bin/main');
+const artifacts = resolve(process.env.CJTUI_LAYOUT_PTY_ARTIFACTS ?? await mkdtemp(join(tmpdir(), 'cjtui-layout-pty-')));
+await mkdir(artifacts, { recursive: true });
+const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
+const quote = s => `'${s.replaceAll("'", "'\\''")}'`;
+const read = async path => { try { return await readFile(path, 'utf8'); } catch { return ''; } };
+async function until(predicate, name, ms = 7000) {
+  const end = Date.now() + ms;
+  while (Date.now() < end) { if (await predicate()) return; await delay(25); }
+  throw new Error(`timeout: ${name}`);
+}
+// The example stream uses the already supported CUP and SGR subset. Each test row
+// update must cover the complete row, making residual-cell checks unambiguous.
+const segmenter = new Intl.Segmenter('en', { granularity: 'grapheme' });
+function columns(text) {
+  let count = 0;
+  for (const { segment } of segmenter.segment(text)) {
+    const cp = segment.codePointAt(0);
+    if (/^\p{Mark}+$/u.test(segment)) continue;
+    const wide = /\p{Extended_Pictographic}|\p{Regional_Indicator}/u.test(segment) ||
+      (cp >= 0x1100 && (cp <= 0x115f || cp === 0x2329 || cp === 0x232a ||
+       (cp >= 0x2e80 && cp <= 0xa4cf && cp !== 0x303f) ||
+       (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) ||
+       (cp >= 0xfe10 && cp <= 0xfe19) || (cp >= 0xfe30 && cp <= 0xfe6f) ||
+       (cp >= 0xff00 && cp <= 0xff60) || (cp >= 0xffe0 && cp <= 0xffe6) || cp >= 0x20000));
+    count += wide ? 2 : 1;
+  }
+  return count;
+}
+class Screen {
+  constructor(width, height) { this.resize(width, height); this.pending = ''; this.decoder = new StringDecoder('utf8'); this.updates = 0; this.row = null; this.text = ''; }
+  resize(width, height) { this.width = width; this.height = height; this.rows = Array(height).fill(' '.repeat(width)); }
+  flush() {
+    if (this.row === null) return;
+    assert.equal(columns(this.text), this.width, `complete actual-width row ${this.row + 1}: ${JSON.stringify(this.text)}`);
+    this.rows[this.row] = this.text;
+    this.row = null; this.text = ''; this.updates++;
+  }
+  feed(bytes) {
+    this.pending += this.decoder.write(bytes);
+    while (this.pending.length) {
+      if (this.pending[0] === '\x1b') {
+        const match = /^\x1b\[([0-9;]*)([A-Za-z])/.exec(this.pending);
+        if (!match) { if (/^\x1b(?:\[[0-9;]*)?$/.test(this.pending)) break; throw new Error(`unsupported output: ${JSON.stringify(this.pending.slice(0, 32))}`); }
+        this.pending = this.pending.slice(match[0].length);
+        if (match[2] === 'm') continue;
+        assert.equal(match[2], 'H', 'example emits supported absolute row positioning');
+        this.flush();
+        const parts = match[1].split(';').map(Number);
+        assert.equal(parts.length, 2, 'explicit row and column');
+        assert.equal(parts[1], 1, 'existing Linux backend writes complete rows from column one');
+        assert(parts[0] >= 1 && parts[0] <= this.height, `actual row bounds ${parts[0]} <= ${this.height}`);
+        this.row = parts[0] - 1;
+      } else {
+        const end = this.pending.indexOf('\x1b');
+        const text = end < 0 ? this.pending : this.pending.slice(0, end);
+        assert(this.row !== null, 'text follows addressed position');
+        assert(!/[\x00-\x1f\x7f-\x9f]/u.test(text), 'no raw output controls/newline scrolling');
+        this.text += text;
+        this.pending = end < 0 ? '' : this.pending.slice(end);
+      }
+    }
+  }
+  settle() { this.flush(); assert.equal(this.pending, '', 'no incomplete ANSI remains after completed repaint'); return this.rows.join('\n'); }
+}
+const decorated = text => /[╭╮╰╯]/u.test(text) && text.includes('░');
+const noDecoration = text => !/[┌┐└┘─│╭╮╰╯╔╗╚╝═║░]/u.test(text);
+const dir = await mkdtemp(join(tmpdir(), 'cjtui-layout-session-'));
+const wrapper = join(dir, 'session.sh');
+await writeFile(wrapper, '#!/bin/sh\nstty rows 14 cols 48\nstty -g > "$2/before"\ntty > "$2/tty"\n"$1" < /dev/tty &\np=$!\necho "$p" > "$2/pid"\nwait "$p"\nstatus=$?\nstty -g > "$2/after"\nexit "$status"\n');
+const child = spawn('script', ['--quiet', '--return', '--flush', '--command', `sh ${quote(wrapper)} ${quote(binary)} ${quote(dir)}`, '/dev/null'], { stdio: ['pipe', 'pipe', 'pipe'], env: { ...process.env, TERM: 'xterm-256color' } });
+let raw = Buffer.alloc(0), stderr = '', finished = false, exitCode, exitSignal, parseError, pid;
+const screen = new Screen(48, 14);
+child.stdout.on('data', bytes => { raw = Buffer.concat([raw, bytes]); try { screen.feed(bytes); } catch (error) { parseError ??= error; } });
+child.stderr.on('data', bytes => { stderr += bytes.toString(); });
+child.on('error', error => { parseError ??= error; finished = true; });
+child.on('exit', (code, signal) => { exitCode = code; exitSignal = signal; finished = true; });
+async function settled(name, predicate) {
+  await until(() => { if (parseError) throw parseError; return predicate(); }, name);
+  await delay(250);
+  if (parseError) throw parseError;
+  return screen.settle();
+}
+async function save(name, text) { await writeFile(join(artifacts, `${name}.txt`), text); }
+async function toggle(name) {
+  const before = raw.length;
+  child.stdin.write('d');
+  return settled(name, () => raw.length > before);
+}
+async function resize(width, height) {
+  const before = raw.length;
+  screen.settle(); screen.resize(width, height);
+  const tty = (await read(join(dir, 'tty'))).trim();
+  const changed = spawnSync('stty', ['-F', tty, 'rows', `${height}`, 'cols', `${width}`], { encoding: 'utf8' });
+  assert.equal(changed.status, 0, changed.stderr);
+  process.kill(pid, 'SIGWINCH');
+  return settled(`resize ${width}x${height}`, () => raw.length > before);
+}
+try {
+  for (const command of ['script', 'stty']) assert.equal(spawnSync(command, ['--version']).status, 0, `${command} available`);
+  await until(async () => { pid = Number((await read(join(dir, 'pid'))).trim()); return pid > 0; }, 'actual example PID');
+  const initial = await settled('first decorated frame', () => raw.length > 0);
+  assert(decorated(initial), 'initial actual example contains rounded corners and exposed shadow');
+  await save('01-initial-48x14', initial);
+  const idle = raw.length; await delay(250); assert.equal(raw.length, idle, 'idle does not emit screen updates');
+  const off = await toggle('decoration disabled');
+  assert(noDecoration(off), 'd clears every previous border/shadow cell in actual screen');
+  await save('02-disabled-48x14', off);
+  const restored = await toggle('decoration restored');
+  assert.equal(restored, initial, 'second d restores complete initial screen without stale cells');
+  await save('03-restored-48x14', restored);
+  await save('04-resize-23x9', await resize(23, 9));
+  const tiny = await resize(8, 4);
+  await save('05-resize-8x4', tiny);
+  const tinyVisible = !noDecoration(tiny);
+  const tinyOff = tinyVisible ? await toggle('tiny decoration disabled') : (child.stdin.write('d'), await delay(350), screen.settle());
+  assert(noDecoration(tinyOff), 'tiny frame clears decoration too');
+  await save('06-disabled-8x4', tinyOff);
+  const tinyRestored = tinyVisible ? await toggle('tiny decoration restored') : (child.stdin.write('d'), await delay(350), screen.settle());
+  assert.equal(tinyRestored, tiny, 'tiny decoration round trip is deterministic');
+  const enlarged = await resize(48, 14);
+  assert.equal(enlarged, initial, 'resize back restores complete original geometry');
+  await save('07-resize-back-48x14', enlarged);
+  child.stdin.write('q');
+  await until(() => finished, 'q stops actual example');
+  assert.equal(exitCode, 0, 'example exits normally');
+  assert.equal(exitSignal, null, 'no forced signal');
+  const before = (await read(join(dir, 'before'))).trim(), after = (await read(join(dir, 'after'))).trim();
+  assert(before && after, 'actual termios captured before and after');
+  assert.equal(after, before, 'application restores exact termios');
+  await writeFile(join(artifacts, 'termios.txt'), `before=${before}\nafter=${after}\n`);
+  console.log(`PASS layout PTY: exit=0, d clears/restores, 48x14→23x9→8x4→48x14, termios restored; artifacts=${artifacts}`);
+} catch (error) {
+  console.error(`FAIL layout PTY: ${error.stack}; exit=${exitCode}, signal=${exitSignal}, artifacts=${artifacts}`);
+  process.exitCode = 1;
+} finally {
+  await writeFile(join(artifacts, 'session.raw'), raw);
+  await writeFile(join(artifacts, 'stderr.txt'), stderr);
+  if (!finished) { if (pid) { try { process.kill(pid, 'SIGKILL'); } catch {} } child.kill('SIGKILL'); }
+  child.stdin.destroy();
+}
