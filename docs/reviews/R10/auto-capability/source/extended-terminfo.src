# Synthetic records used solely to verify the ncurses extension lookup path.
# They make no claim about a physical terminal.
probe-rgb|probe RGB extension,
	use=xterm-256color,
	RGB,

probe-tc|probe Tc extension,
	use=xterm-256color,
	Tc,

probe-16|probe 16-color numeric capability,
	use=xterm-256color,
	colors#16,
